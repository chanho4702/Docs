+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.mockito.InjectMocks;
+import org.mockito.Mock;
+import org.mockito.junit.jupiter.MockitoExtension;
+
+/** 프록시·프록시 그룹 컨트롤러 — 기본 기능(라이선스 게이트 없음) + 관리자 가드. 비admin은 ForbiddenError, 서비스는 안 부른다. */
+@ExtendWith(MockitoExtension.class)
+class ZabbixProxyManageControllerTest {
+
+    @Mock ZabbixProxyManageService proxyService;
+    @Mock ZabbixProxyGroupManageService groupService;
+    @InjectMocks ZabbixProxyManageController proxies;
+    @InjectMocks ZabbixProxyGroupManageController groups;
+
+    private static TokenUserInfo user(UserRole role) {
+        return TokenUserInfo.builder().id(1).userRole(role).build();
+    }
+
+    @Test
+    void basicFeatureHasNoLicenseGate() {
+        assertThat(ZabbixProxyManageController.class.getAnnotation(RequiresFeature.class)).isNull();
+        assertThat(ZabbixProxyGroupManageController.class.getAnnotation(RequiresFeature.class)).isNull();
+    }
+
+    @Test
+    void nonAdminIsForbiddenOnEveryEndpoint() {
+        TokenUserInfo u = user(UserRole.USER);
+        ProxyDeleteReqDto del = new ProxyDeleteReqDto();
+        del.setIds(List.of("1"));
+        assertThatThrownBy(() -> proxies.list(u)).isInstanceOf(ForbiddenError.class);
+        assertThatThrownBy(() -> proxies.options(u)).isInstanceOf(ForbiddenError.class);
+        assertThatThrownBy(() -> proxies.get(u, "1")).isInstanceOf(ForbiddenError.class);
+        assertThatThrownBy(() -> proxies.create(u, new ProxyUpsertReqDto())).isInstanceOf(ForbiddenError.class);
+        assertThatThrownBy(() -> proxies.update(u, "1", new ProxyUpsertReqDto())).isInstanceOf(ForbiddenError.class);
+        assertThatThrownBy(() -> proxies.delete(u, del)).isInstanceOf(ForbiddenError.class);
+        assertThatThrownBy(() -> groups.list(u)).isInstanceOf(ForbiddenError.class);
+        assertThatThrownBy(() -> groups.get(u, "1")).isInstanceOf(ForbiddenError.class);
+        assertThatThrownBy(() -> groups.create(u, new ProxyGroupUpsertReqDto())).isInstanceOf(ForbiddenError.class);
+        assertThatThrownBy(() -> groups.update(u, "1", new ProxyGroupUpsertReqDto())).isInstanceOf(ForbiddenError.class);
+        assertThatThrownBy(() -> groups.delete(u, del)).isInstanceOf(ForbiddenError.class);
+        verifyNoInteractions(proxyService, groupService);
+    }
+
+    @Test
+    void adminListDelegates() {
+        List<ManagedProxyDto> rows = List.of();
+        when(proxyService.list()).thenReturn(rows);
+        assertThat(proxies.list(user(UserRole.ADMIN)).getData()).isSameAs(rows);
+    }
+}
