+@Slf4j
+@Service
+@RequiredArgsConstructor
+public class ZabbixProxyManageService {
+
+    /** Zabbix 7.0 프록시 타임아웃 10종 — 필드 이름은 {@code timeout_} + 키. */
+    static final List<String> TIMEOUT_KEYS = List.of("zabbix_agent", "simple_check", "snmp_agent", "external_check",
+            "db_monitor", "http_agent", "ssh_agent", "telnet_agent", "script", "browser");
+    static final int HOST_LIST_CAP = 500;
+    private static final int TLS_NONE = 1;
+    private static final int TLS_PSK = 2;
+    private static final int TLS_CERT = 4;
+    /** 액션 조건 유형 "프록시"(CONDITION_TYPE_PROXY) — 디스커버리·자동 등록 액션. */
+    private static final String CONDITION_PROXY = "20";
+    private static final String NO_GROUP = "0";
+    private static final String MASK = "***";
+    private static final String[] PROXY_STATES = { "UNKNOWN", "OFFLINE", "ONLINE" };
+    private static final String[] COMPATIBILITY = { "UNDEFINED", "CURRENT", "OUTDATED", "UNSUPPORTED" };
+
+    private final ZabbixProxyService proxyService;
+    private final ZabbixProxyGroupService proxyGroupService;
+    private final ZabbixDiscoveryService discoveryService;
+    private final ZabbixActionService actionService;
+    private final ZabbixSettingsService settingsService;
+    private final ZabbixUserService zabbixUserService;
+    private final ZabbixChangeLogRepository changeLogRepository;
+    private final ActorResolver actorResolver;
+
+    // ====================================================================
+    // GET / · GET /{id} · GET /options
+    // ====================================================================
+
+    public List<ManagedProxyDto> list() {
+        String token = zabbixUserService.getSuperAdminToken();
+        Map<String, Object> params = new LinkedHashMap<>();
+        params.put("output", "extend");
+        params.put("selectHosts", "count");
+        params.put("selectAssignedHosts", "count");
+        params.put("sortfield", "name");
+        Map<String, String> groups = groupNames(token);
+        return proxyService.getRaw(token, params).stream()
+                .map(p -> toSummary(p, groups, intOr(p.get("hosts"), 0), intOr(p.get("assignedHosts"), 0)))
+                .toList();
+    }
+
+    public ManagedProxyDetailDto get(String proxyid) {
+        String token = zabbixUserService.getSuperAdminToken();
+        Map<String, Object> p = fetchRaw(token, proxyid, true);
+        List<HostRef> hosts = hostRefs(p.get("hosts"));
+        List<HostRef> assigned = hostRefs(p.get("assignedHosts"));
+        Map<String, String> timeouts = new LinkedHashMap<>();
+        for (String k : TIMEOUT_KEYS) timeouts.put(k, strOrEmpty(p.get("timeout_" + k)));
+        return new ManagedProxyDetailDto(toSummary(p, groupNames(token), hosts.size(), assigned.size()),
+                strOrEmpty(p.get("tls_issuer")), strOrEmpty(p.get("tls_subject")), timeouts,
+                cap(hosts), cap(assigned), hosts.size() > HOST_LIST_CAP || assigned.size() > HOST_LIST_CAP,
+                discoveryRules(token, List.of(proxyid)).getOrDefault(proxyid, List.of()));
+    }
+
+    public ProxyOptionsDto options() {
+        String token = zabbixUserService.getSuperAdminToken();
+        List<Ref> groups = groupNames(token).entrySet().stream()
+                .map(e -> new Ref(e.getKey(), e.getValue()))
+                .sorted(Comparator.comparing((Ref r) -> lower(r.name())))
+                .toList();
+        return new ProxyOptionsDto(groups, globalTimeouts(token));
+    }
+
+    // ====================================================================
+    // POST · PUT /{id} · DELETE
+    // ====================================================================
+
+    public ManagedProxyDetailDto create(ProxyUpsertReqDto req, TokenUserInfo user) {
+        String token = zabbixUserService.getSuperAdminToken();
+        if (isBlank(req.getName())) throw new ApiError(ErrorCode.PROXY_NAME_REQUIRED);
+        if (req.getOperatingMode() == null) throw new ApiError(ErrorCode.PROXY_MODE_INVALID);
+        Map<String, Object> params = toParams(req, null, () -> globalTimeouts(token));
+        String id = proxyService.create(token, params);
+        if (id == null) throw new ApiError(ErrorCode.PROXY_CREATE_FAILED);
+        writeLog(ZabbixChangeLog.ACTION_CREATE, id, str(params.get("name")), logPayload(params), user);
+        return get(id);
+    }
+
+    public ManagedProxyDetailDto update(String proxyid, ProxyUpsertReqDto req, TokenUserInfo user) {
+        String token = zabbixUserService.getSuperAdminToken();
+        Map<String, Object> current = fetchRaw(token, proxyid, false);
+        Map<String, Object> params = toParams(req, current, () -> globalTimeouts(token));
+        params.put("proxyid", proxyid);
+        proxyService.update(token, params);
+        String name = params.containsKey("name") ? str(params.get("name")) : str(current.get("name"));
+        Map<String, Object> payload = logPayload(params);
+        payload.put("fields", params.keySet().stream().filter(k -> !"proxyid".equals(k)).toList());
+        writeLog(ZabbixChangeLog.ACTION_UPDATE, proxyid, name, payload, user);
+        return get(proxyid);
+    }
+
+    public DiscoveryDeleteResDto delete(List<String> ids, TokenUserInfo user) {
+        List<String> clean = ids == null ? List.of()
+                : ids.stream().filter(x -> x != null && !x.isBlank()).map(String::trim).distinct().toList();
+        if (clean.isEmpty()) throw new ApiError(ErrorCode.PROXY_IDS_REQUIRED);
+        String token = zabbixUserService.getSuperAdminToken();
+        Map<String, Object> params = new LinkedHashMap<>();
+        params.put("proxyids", clean);
+        params.put("output", List.of("proxyid", "name"));
+        params.put("selectHosts", List.of("hostid", "name"));
+        List<Map<String, Object>> rows = proxyService.getRaw(token, params);
+        if (rows.size() < clean.size()) throw new ApiError(ErrorCode.PROXY_NOT_FOUND);
+
+        // 🔴 하나라도 쓰이면 아무것도 지우지 않는다 — Zabbix 원문("Host "h" is monitored by proxy "p".")은 첫 호스트 하나만 말한다.
+        Map<String, List<Ref>> drules = discoveryRules(token, clean);
+        Map<String, List<String>> actions = actionsUsing(token, clean);
+        Map<String, String> names = new HashMap<>();
+        List<String> blocked = new ArrayList<>();
+        for (Map<String, Object> p : rows) {
+            String id = str(p.get("proxyid"));
+            names.put(id, str(p.get("name")));
+            List<String> uses = new ArrayList<>();
+            List<HostRef> hosts = hostRefs(p.get("hosts"));
+            if (!hosts.isEmpty()) {
+                List<String> first = hosts.stream().limit(3).map(HostRef::name).toList();
+                uses.add("호스트 " + hosts.size() + "개(" + String.join(", ", first) + (hosts.size() > 3 ? " 외" : "") + ")");
+            }
+            List<Ref> rules = drules.getOrDefault(id, List.of());
+            if (!rules.isEmpty()) uses.add("디스커버리 규칙 " + String.join(", ", rules.stream().map(Ref::name).toList()));
+            List<String> usingActions = actions.getOrDefault(id, List.of());
+            if (!usingActions.isEmpty()) uses.add("액션 " + String.join(", ", usingActions));
+            if (!uses.isEmpty()) blocked.add(str(p.get("name")) + " ← " + String.join(", ", uses));
+        }
+        if (!blocked.isEmpty()) throw new ApiError(ErrorCode.PROXY_IN_USE.getCode() + ": " + String.join(" / ", blocked));
+        proxyService.delete(token, clean);
+        for (String id : clean) writeLog(ZabbixChangeLog.ACTION_DELETE, id, names.get(id), Map.of(), user);
+        return new DiscoveryDeleteResDto(clean, clean.size());
+    }
+
+    // ====================================================================
+    // 요청 → Zabbix params
+    // ====================================================================
+
+    /**
+     * 요청을 Zabbix params로. {@code current}가 null이면 생성.
+     *
+     * <p>모드·TLS·그룹·타임아웃은 "결과 상태"(요청 값 ?: 현재 값)로 판정한다 — 수정은 보낸 것만 오기 때문이다.
+     */
+    static Map<String, Object> toParams(ProxyUpsertReqDto req, Map<String, Object> current,
+            Supplier<Map<String, String>> globalTimeouts) {
+        boolean creating = current == null;
+        Map<String, Object> p = new LinkedHashMap<>();
+
+        if (req.getName() != null) {
+            if (req.getName().isBlank()) throw new ApiError(ErrorCode.PROXY_NAME_REQUIRED);
+            p.put("name", req.getName().trim());
+        }
+        int currentMode = creating ? -1 : intOr(current.get("operating_mode"), ManagedProxyDto.MODE_ACTIVE);
+        Integer reqMode = req.getOperatingMode();
+        if (reqMode != null && reqMode != ManagedProxyDto.MODE_ACTIVE && reqMode != ManagedProxyDto.MODE_PASSIVE) {
+            throw new ApiError(ErrorCode.PROXY_MODE_INVALID);
+        }
+        int mode = reqMode != null ? reqMode : currentMode;
+        boolean modeChanged = !creating && reqMode != null && reqMode != currentMode;
+        if (reqMode != null) p.put("operating_mode", reqMode);
+        if (req.getDescription() != null) p.put("description", req.getDescription());
+
+        // --- 그룹
+        String group = creating ? NO_GROUP : strOr(current.get("proxy_groupid"), NO_GROUP);
+        if (req.getProxyGroupid() != null) {
+            group = isBlank(req.getProxyGroupid()) ? NO_GROUP : req.getProxyGroupid().trim();
+            p.put("proxy_groupid", group);
+        }
+        if (!NO_GROUP.equals(group)) {
+            String localAddress = req.getLocalAddress() != null ? req.getLocalAddress()
+                    : creating ? null : str(current.get("local_address"));
+            if (isBlank(localAddress)) throw new ApiError(ErrorCode.PROXY_LOCAL_ADDRESS_REQUIRED);
+            if (req.getLocalAddress() != null) p.put("local_address", req.getLocalAddress().trim());
+            putGiven(p, "local_port", req.getLocalPort(), creating);
+        }
+        // 그룹 밖이면 local_*를 보내지 않는다 — Zabbix가 기본값으로 둔다(그룹 없이 local_port는 10051만 받는다).
+
+        // --- 주소: 모드에 맞는 쪽만
+        if (mode == ManagedProxyDto.MODE_ACTIVE) {
+            if (req.getAllowedAddresses() != null) p.put("allowed_addresses", req.getAllowedAddresses().trim());
+        } else {
+            putGiven(p, "address", req.getAddress(), creating);
+            putGiven(p, "port", req.getPort(), creating);
+        }
+
+        // --- TLS: 모드별 정규화 + PSK
+        int currentConnect = creating ? TLS_NONE : intOr(current.get("tls_connect"), TLS_NONE);
+        int currentAccept = creating ? TLS_NONE : intOr(current.get("tls_accept"), TLS_NONE);
+        boolean touchesTls = req.getTlsConnect() != null || req.getTlsAccept() != null;
+        Integer newSide = mode == ManagedProxyDto.MODE_ACTIVE ? req.getTlsAccept() : req.getTlsConnect();
+        // 🔴 암호화를 쓰던 프록시의 모드를 바꾸면서 새 모드의 방식을 안 정하면 "없음"으로 저장된다 — 묵시적 해제를 막는다.
+        if (modeChanged && newSide == null && usesTls(currentMode, currentConnect, currentAccept)) {
+            throw new ApiError(ErrorCode.PROXY_TLS_REQUIRED);
+        }
+        int connect;
+        int accept;
+        if (mode == ManagedProxyDto.MODE_ACTIVE) {
+            connect = TLS_NONE;
+            accept = req.getTlsAccept() != null ? req.getTlsAccept() : modeChanged ? TLS_NONE : currentAccept;
+            if (req.getTlsAccept() != null) p.put("tls_accept", accept);
+            if (creating || modeChanged || touchesTls) p.put("tls_connect", TLS_NONE);
+        } else {
+            accept = TLS_NONE;
+            connect = req.getTlsConnect() != null ? req.getTlsConnect() : modeChanged ? TLS_NONE : currentConnect;
+            if (req.getTlsConnect() != null) p.put("tls_connect", connect);
+            if (creating || modeChanged || touchesTls) p.put("tls_accept", TLS_NONE);
+        }
+        boolean wantsPsk = usesPsk(mode, connect, accept);
+        // 모드를 바꿔도 결과가 계속 PSK면 Zabbix가 PSK를 유지한다(실측) — 그래서 modeChanged는 보지 않는다.
+        boolean hasPsk = !creating && usesPsk(currentMode, currentConnect, currentAccept);
+        if (wantsPsk && !hasPsk && (isBlank(req.getTlsPskIdentity()) || isBlank(req.getTlsPsk()))) {
+            throw new ApiError(ErrorCode.PROXY_PSK_REQUIRED);
+        }
+        // 비우면 유지 — 비밀값은 다듬지 않는다(식별자 앞뒤 공백도 그대로 Zabbix 판단에 맡김).
+        if (!isBlank(req.getTlsPskIdentity())) p.put("tls_psk_identity", req.getTlsPskIdentity());
+        if (!isBlank(req.getTlsPsk())) p.put("tls_psk", req.getTlsPsk().trim());
+        // 인증서를 안 쓰면 발급자·주체를 보내지 않는다 — 비어 있지 않으면 Zabbix가 거부하고, 안 보내면 스스로 비운다(실측).
+        if (usesCert(mode, connect, accept)) {
+            if (req.getTlsIssuer() != null) p.put("tls_issuer", req.getTlsIssuer());
+            if (req.getTlsSubject() != null) p.put("tls_subject", req.getTlsSubject());
+        }
+
+        // --- 타임아웃
+        // 0·1 밖의 값은 그대로 보내 Zabbix가 거부하게 한다(잘못된 입력을 "끄기"로 바꾸지 않는다).
+        if (req.getCustomTimeouts() != null) p.put("custom_timeouts", req.getCustomTimeouts());
+        boolean custom = req.getCustomTimeouts() != null ? req.getCustomTimeouts() == 1
+                : !creating && "1".equals(str(current.get("custom_timeouts")));
+        if (custom && (req.getCustomTimeouts() != null || req.getTimeouts() != null)) {
+            Map<String, String> given = req.getTimeouts() == null ? Map.of() : req.getTimeouts();
+            Map<String, String> global = null;
+            for (String k : TIMEOUT_KEYS) {
+                String v = given.get(k);
+                if (isBlank(v) && !creating) v = str(current.get("timeout_" + k));
+                if (isBlank(v)) {
+                    if (global == null) global = globalTimeouts.get();
+                    v = global.get(k);
+                }
+                // 그래도 비면 보내지 않는다 — Zabbix가 어느 칸이 비었는지 원문으로 알려 준다.
+                if (!isBlank(v)) p.put("timeout_" + k, v.trim());
+            }
+        }
+        return p;
+    }
+
+    static boolean usesPsk(int mode, int connect, int accept) {
+        return mode == ManagedProxyDto.MODE_ACTIVE ? (accept & TLS_PSK) != 0 : connect == TLS_PSK;
+    }
+
+    static boolean usesCert(int mode, int connect, int accept) {
+        return mode == ManagedProxyDto.MODE_ACTIVE ? (accept & TLS_CERT) != 0 : connect == TLS_CERT;
+    }
+
+    /** 암호화(PSK·인증서)를 하나라도 쓰는가. */
+    static boolean usesTls(int mode, int connect, int accept) {
+        return usesPsk(mode, connect, accept) || usesCert(mode, connect, accept);
+    }
+
+    /** 🔴 이력에는 PSK 값을 남기지 않는다(이력은 프록시 삭제 뒤에도 남는다). */
+    static Map<String, Object> logPayload(Map<String, Object> params) {
+        Map<String, Object> out = new LinkedHashMap<>(params);
+        out.remove("proxyid");
+        out.computeIfPresent("tls_psk_identity", (k, v) -> MASK);
+        out.computeIfPresent("tls_psk", (k, v) -> MASK);
+        return out;
+    }
+
+    // ====================================================================
+    // Zabbix 응답 → DTO
+    // ====================================================================
+
+    static ManagedProxyDto toSummary(Map<String, Object> p, Map<String, String> groups, int hostCount, int assignedCount) {
+        int mode = intOr(p.get("operating_mode"), ManagedProxyDto.MODE_ACTIVE);
+        String groupId = strOr(p.get("proxy_groupid"), NO_GROUP);
+        Ref group = NO_GROUP.equals(groupId) ? null : new Ref(groupId, groups.get(groupId));
+        int connect = intOr(p.get("tls_connect"), TLS_NONE);
+        int accept = intOr(p.get("tls_accept"), TLS_NONE);
+        long lastAccess = longOr(p.get("lastaccess"), 0);
+        return new ManagedProxyDto(str(p.get("proxyid")), str(p.get("name")), mode, group,
+                strOrEmpty(p.get("address")), strOrEmpty(p.get("port")), strOrEmpty(p.get("allowed_addresses")),
+                strOrEmpty(p.get("local_address")), strOrEmpty(p.get("local_port")), strOrEmpty(p.get("description")),
+                label(PROXY_STATES, intOr(p.get("state"), 0)), lastAccess > 0 ? lastAccess : null,
+                version(p.get("version")), label(COMPATIBILITY, intOr(p.get("compatibility"), 0)),
+                hostCount, assignedCount, connect, accept, usesPsk(mode, connect, accept),
+                "1".equals(str(p.get("custom_timeouts"))));
+    }
+
+    /** Zabbix 정수 버전(70013) → "7.0.13". 0·형식 불명이면 null. */
+    static String version(Object raw) {
+        long v = longOr(raw, 0);
+        if (v <= 0) return null;
+        return (v / 10000) + "." + (v / 100 % 100) + "." + (v % 100);
+    }
+
+    static String label(String[] names, int code) {
+        return code >= 0 && code < names.length ? names[code] : names[0];
+    }
+
+    // ====================================================================
+    // 내부
+    // ====================================================================
+
+    private Map<String, Object> fetchRaw(String token, String proxyid, boolean withHosts) {
+        Map<String, Object> params = new LinkedHashMap<>();
+        params.put("proxyids", List.of(proxyid));
+        params.put("output", "extend");
+        if (withHosts) {
+            params.put("selectHosts", List.of("hostid", "name"));
+            params.put("selectAssignedHosts", List.of("hostid", "name"));
+        }
+        List<Map<String, Object>> rows = proxyService.getRaw(token, params);
+        if (rows.isEmpty()) throw new ApiError(ErrorCode.PROXY_NOT_FOUND);
+        return rows.get(0);
+    }
+
+    private Map<String, String> groupNames(String token) {
+        Map<String, Object> params = new LinkedHashMap<>();
+        params.put("output", List.of("proxy_groupid", "name"));
+        Map<String, String> out = new LinkedHashMap<>();
+        for (Map<String, Object> g : proxyGroupService.getRaw(token, params)) {
+            out.put(str(g.get("proxy_groupid")), str(g.get("name")));
+        }
+        return out;
+    }
+
+    /** proxyid → 그 프록시로 도는 네트워크 디스커버리 규칙(이름순). */
+    private Map<String, List<Ref>> discoveryRules(String token, List<String> proxyids) {
+        Map<String, Object> params = new LinkedHashMap<>();
+        params.put("output", List.of("druleid", "name", "proxyid"));
+        params.put("filter", Map.of("proxyid", proxyids));
+        Map<String, List<Ref>> out = new HashMap<>();
+        for (Map<String, Object> r : discoveryService.getRulesRaw(token, params)) {
+            out.computeIfAbsent(str(r.get("proxyid")), k -> new ArrayList<>()).add(new Ref(str(r.get("druleid")), str(r.get("name"))));
+        }
+        out.values().forEach(l -> l.sort(Comparator.comparing((Ref r) -> lower(r.name()))));
+        return out;
+    }
+
+    /** proxyid → 프록시 조건(conditiontype 20)으로 이 프록시를 쓰는 액션 이름. 액션은 수십 개 규모라 전체를 한 번 읽는다. */
+    private Map<String, List<String>> actionsUsing(String token, List<String> proxyids) {
+        Map<String, Object> params = new LinkedHashMap<>();
+        params.put("output", List.of("actionid", "name"));
+        params.put("selectFilter", List.of("conditions"));
+        Map<String, List<String>> out = new HashMap<>();
+        for (Map<String, Object> a : actionService.getRaw(token, params)) {
+            Object filter = a.get("filter");
+            List<Map<String, Object>> conditions = filter instanceof Map<?, ?> f ? asList(f.get("conditions")) : List.of();
+            for (Map<String, Object> c : conditions) {
+                String value = str(c.get("value"));
+                if (CONDITION_PROXY.equals(str(c.get("conditiontype"))) && proxyids.contains(value)) {
+                    List<String> names = out.computeIfAbsent(value, k -> new ArrayList<>());
+                    if (!names.contains(str(a.get("name")))) names.add(str(a.get("name")));
+                }
+            }
+        }
+        return out;
+    }
+
+    /** settings.get의 timeout_* → 키에서 접두사를 뗀 맵. 못 읽으면 빈 맵(폼은 빈 칸, 저장 시 Zabbix가 원문으로 알린다). */
+    private Map<String, String> globalTimeouts(String token) {
+        try {
+            Map<String, Object> s = settingsService.get(token, TIMEOUT_KEYS.stream().map(k -> "timeout_" + k).toList());
+            Map<String, String> out = new LinkedHashMap<>();
+            for (String k : TIMEOUT_KEYS) {
+                String v = str(s.get("timeout_" + k));
+                if (v != null) out.put(k, v);
+            }
+            return out;
+        } catch (RuntimeException e) {
+            log.warn("settings.get failed — global timeouts omitted: {}", e.getMessage());
+            return Map.of();
+        }
+    }
+
+    private static List<HostRef> hostRefs(Object raw) {
+        List<HostRef> out = new ArrayList<>();
+        for (Map<String, Object> h : asList(raw)) out.add(new HostRef(str(h.get("hostid")), str(h.get("name"))));
+        out.sort(Comparator.comparing((HostRef h) -> lower(h.name())));
+        return out;
+    }
+
+    private static <T> List<T> cap(List<T> list) {
+        return list.size() > HOST_LIST_CAP ? List.copyOf(list.subList(0, HOST_LIST_CAP)) : list;
+    }
+
+    private void writeLog(String action, String entityId, String entityName, Map<String, Object> payload, TokenUserInfo user) {
+        try {
+            changeLogRepository.save(ZabbixChangeLog.builder()
+                    .entityType(ZabbixChangeLog.ENTITY_PROXY).entityId(entityId).entityName(entityName)
+                    .action(action).payload(payload).actor(actorResolver.resolve(user)).build());
+        } catch (Exception e) {
+            log.warn("zabbix_change_log insert failed (PROXY action={}, id={}): {}", action, entityId, e.getMessage());
+        }
+    }
+
+    /**
+     * 생성은 비면 생략(Zabbix 기본값), 수정은 보냈으면 빈 값도 그대로 보낸다 — 빈 주소를 조용히 "유지"로 바꾸지 않고
+     * Zabbix가 원문으로 거부하게 한다("cannot be empty").
+     */
+    private static void putGiven(Map<String, Object> params, String key, String value, boolean creating) {
+        if (value == null || (creating && value.isBlank())) return;
+        params.put(key, value.trim());
+    }
+
+    private static boolean isBlank(String s) { return s == null || s.isBlank(); }
+
+    private static String lower(String s) { return s == null ? "" : s.toLowerCase(); }
+
+    @SuppressWarnings("unchecked")
+    private static List<Map<String, Object>> asList(Object v) {
+        if (v instanceof List<?> l) return (List<Map<String, Object>>) l;
+        return List.of();
+    }
+
+    private static String str(Object v) { return v == null ? null : String.valueOf(v); }
+
+    private static String strOrEmpty(Object v) { return v == null ? "" : String.valueOf(v); }
+
+    private static String strOr(Object v, String def) {
+        String s = str(v);
+        return s == null || s.isBlank() ? def : s;
+    }
+
+    private static int intOr(Object v, int def) {
+        if (v instanceof Number n) return n.intValue();
+        if (v == null) return def;
+        try { return Integer.parseInt(String.valueOf(v).trim()); } catch (NumberFormatException e) { return def; }
+    }
+
+    private static long longOr(Object v, long def) {
+        if (v instanceof Number n) return n.longValue();
+        if (v == null) return def;
+        try { return Long.parseLong(String.valueOf(v).trim()); } catch (NumberFormatException e) { return def; }
+    }
+}
