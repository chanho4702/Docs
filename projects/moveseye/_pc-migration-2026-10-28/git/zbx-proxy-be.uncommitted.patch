+++ b/engine-zabbix/src/main/java/com/dmove/moveseye/zabbix/proxy/ZabbixProxyGroupServiceImpl.java
@@ -0,0 +1,39 @@
+package com.dmove.moveseye.zabbix.proxy;
+
+import com.dmove.moveseye.zabbix.client.ZabbixApiTemplate;
+import com.dmove.moveseye.zabbix.client.ZabbixMethod;
+import java.util.List;
+import java.util.Map;
+import lombok.RequiredArgsConstructor;
+import org.springframework.stereotype.Service;
+
+/** 프록시 그룹 계약 구현 — proxygroup.get/create/update/delete JSON-RPC. 가공 없음. */
+@Service
+@RequiredArgsConstructor
+public class ZabbixProxyGroupServiceImpl implements ZabbixProxyGroupService {
+
+    private final ZabbixApiTemplate api;
+
+    @Override
+    public List<Map<String, Object>> getRaw(String authToken, Map<String, Object> params) {
+        return api.list(ZabbixMethod.PROXYGROUP_GET, params, authToken);
+    }
+
+    @Override
+    public String create(String authToken, Map<String, Object> params) {
+        return api.firstId(ZabbixMethod.PROXYGROUP_CREATE, params, authToken, "proxy_groupids");
+    }
+
+    @Override
+    public void update(String authToken, Map<String, Object> params) {
+        api.exec(ZabbixMethod.PROXYGROUP_UPDATE, params, authToken);
+    }
+
+    @Override
+    public void delete(String authToken, List<String> proxyGroupIds) {
+        if (proxyGroupIds == null || proxyGroupIds.isEmpty()) {
+            return;
+        }
+        api.exec(ZabbixMethod.PROXYGROUP_DELETE, proxyGroupIds, authToken);
+    }
+}
