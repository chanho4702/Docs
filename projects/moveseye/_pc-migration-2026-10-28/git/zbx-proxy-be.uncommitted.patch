+package com.dmove.moveseye.zabbixadmin.dto;
+
+import io.swagger.v3.oas.annotations.media.Schema;
+
+/**
+ * 프록시 목록 행(Zabbix 7.0 {@code proxy.get}). 상태·호환성은 이름으로 풀어 준다.
+ *
+ * <p>{@code pskConfigured}는 "지금 PSK 비트가 켜져 있다"이다 — Zabbix는 PSK 식별자·값을 돌려주지 않지만(쓰기 전용)
+ * 켤 때 둘 다 필수라서, 켜져 있으면 저장돼 있다고 본다.
+ */
+@Schema(description = "프록시 목록 행")
+public record ManagedProxyDto(
+        @Schema(description = "Zabbix proxyid", example = "1") String proxyid,
+        @Schema(description = "프록시 이름(프록시 설정의 Hostname과 같아야 한다)") String name,
+        @Schema(description = "0 액티브 · 1 패시브", example = "0") int operatingMode,
+        @Schema(description = "소속 프록시 그룹. 없으면 null", nullable = true) Ref proxyGroup,
+        @Schema(description = "패시브: 서버가 접속할 주소") String address,
+        @Schema(description = "패시브: 서버가 접속할 포트") String port,
+        @Schema(description = "액티브: 접속을 허용할 프록시 주소(쉼표 구분, 비면 제한 없음)") String allowedAddresses,
+        @Schema(description = "그룹 소속일 때 그룹 안 다른 프록시가 찾아올 주소") String localAddress,
+        @Schema(description = "그룹 소속일 때 포트") String localPort,
+        String description,
+        @Schema(description = "UNKNOWN · OFFLINE · ONLINE", example = "ONLINE") String state,
+        @Schema(description = "마지막 접속(epoch 초). 접속한 적 없으면 null", nullable = true) Long lastAccess,
+        @Schema(description = "프록시 버전(예 7.0.13). 모르면 null", nullable = true) String version,
+        @Schema(description = "UNDEFINED · CURRENT · OUTDATED · UNSUPPORTED", example = "CURRENT") String compatibility,
+        @Schema(description = "이 프록시에 직접 배정된 호스트 수(monitored_by=1)") int hostCount,
+        @Schema(description = "그룹을 통해 지금 이 프록시가 맡은 호스트 수") int assignedHostCount,
+        @Schema(description = "패시브 연결 방식 1 없음 · 2 PSK · 4 인증서") int tlsConnect,
+        @Schema(description = "액티브 수락 방식 비트(1 없음 · 2 PSK · 4 인증서)") int tlsAccept,
+        @Schema(description = "지금 PSK를 쓰는 중(값은 내려가지 않는다)") boolean pskConfigured,
+        @Schema(description = "프록시 전용 타임아웃 사용") boolean customTimeouts) {
+
+    public static final int MODE_ACTIVE = 0;
+    public static final int MODE_PASSIVE = 1;
+
+    /** id·이름 쌍(그룹·디스커버리 규칙). */
+    public record Ref(String id, String name) {
+    }
+
+    /** 호스트 참조 — 호스트 상세로 링크할 수 있게 hostid를 싣는다. */
+    public record HostRef(String hostid, String name) {
+    }
+}
