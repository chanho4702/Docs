+package com.dmove.moveseye.zabbixadmin;
+
+import com.dmove.moveseye.auth.dto.TokenUserInfo;
+import com.dmove.moveseye.auth.security.ActorResolver;
+import com.dmove.moveseye.common.exception.ApiError;
+import com.dmove.moveseye.common.exception.ErrorCode;
+import com.dmove.moveseye.zabbix.host.ZabbixHostService;
+import com.dmove.moveseye.zabbix.identity.user.ZabbixUserService;
+import com.dmove.moveseye.zabbix.proxy.ZabbixProxyGroupService;
+import com.dmove.moveseye.zabbixadmin.domain.ZabbixChangeLog;
+import com.dmove.moveseye.zabbixadmin.domain.ZabbixChangeLogRepository;
+import com.dmove.moveseye.zabbixadmin.dto.DiscoveryDeleteResDto;
+import com.dmove.moveseye.zabbixadmin.dto.ManagedProxyDto.HostRef;
+import com.dmove.moveseye.zabbixadmin.dto.ManagedProxyGroupDetailDto;
+import com.dmove.moveseye.zabbixadmin.dto.ManagedProxyGroupDto;
+import com.dmove.moveseye.zabbixadmin.dto.ManagedProxyGroupDto.Member;
+import com.dmove.moveseye.zabbixadmin.dto.ProxyGroupUpsertReqDto;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import lombok.RequiredArgsConstructor;
+import lombok.extern.slf4j.Slf4j;
+import org.springframework.stereotype.Service;
+
+/**
+ * 프록시 그룹 관리 오케스트레이션 — {@code proxygroup.*}(Zabbix 7.0 신설). Zabbix UI: Administration › Proxy groups.
+ * 계약 `contract_proxy.md` §6.
+ *
+ * <p>소속 프록시는 이 폼에서 바꾸지 않는다 — Zabbix도 {@code proxygroup.create}에 {@code proxies} 인자가 없다(실측).
+ * 배정 호스트 수는 그룹마다 {@code host.get countOutput} 한 번(그룹은 수십 개 규모).
+ */
+@Slf4j
+@Service
+@RequiredArgsConstructor
+public class ZabbixProxyGroupManageService {
+
+    private static final String[] GROUP_STATES = { "UNKNOWN", "OFFLINE", "RECOVERING", "ONLINE", "DEGRADING" };
+    private static final String[] PROXY_STATES = { "UNKNOWN", "OFFLINE", "ONLINE" };
+    private static final String PROXY_ONLINE = "2";
+
+    private final ZabbixProxyGroupService proxyGroupService;
+    private final ZabbixHostService hostService;
+    private final ZabbixUserService zabbixUserService;
+    private final ZabbixChangeLogRepository changeLogRepository;
+    private final ActorResolver actorResolver;
+
+    // ====================================================================
+    // GET / · GET /{id}
+    // ====================================================================
+
+    public List<ManagedProxyGroupDto> list() {
+        String token = zabbixUserService.getSuperAdminToken();
+        return proxyGroupService.getRaw(token, select(null)).stream()
+                .map(g -> toDto(g, countHosts(token, str(g.get("proxy_groupid")))))
+                .toList();
+    }
+
+    public ManagedProxyGroupDetailDto get(String proxyGroupId) {
+        String token = zabbixUserService.getSuperAdminToken();
+        Map<String, Object> g = fetchRaw(token, proxyGroupId);
+        Map<String, Object> params = new LinkedHashMap<>();
+        params.put("output", List.of("hostid", "name"));
+        params.put("proxy_groupids", List.of(proxyGroupId));
+        params.put("sortfield", "name");
+        params.put("limit", ZabbixProxyManageService.HOST_LIST_CAP + 1);
+        List<HostRef> hosts = new ArrayList<>();
+        for (Map<String, Object> h : hostService.getRaw(token, params)) hosts.add(new HostRef(str(h.get("hostid")), str(h.get("name"))));
+        boolean truncated = hosts.size() > ZabbixProxyManageService.HOST_LIST_CAP;
+        if (truncated) hosts = List.copyOf(hosts.subList(0, ZabbixProxyManageService.HOST_LIST_CAP));
+        return new ManagedProxyGroupDetailDto(toDto(g, countHosts(token, proxyGroupId)), hosts, truncated);
+    }
+
+    // ====================================================================
+    // POST · PUT /{id} · DELETE
+    // ====================================================================
+
+    public ManagedProxyGroupDetailDto create(ProxyGroupUpsertReqDto req, TokenUserInfo user) {
+        String token = zabbixUserService.getSuperAdminToken();
+        if (isBlank(req.getName())) throw new ApiError(ErrorCode.PROXY_GROUP_NAME_REQUIRED);
+        Map<String, Object> params = toParams(req, true);
+        String id = proxyGroupService.create(token, params);
+        if (id == null) throw new ApiError(ErrorCode.PROXY_GROUP_CREATE_FAILED);
+        writeLog(ZabbixChangeLog.ACTION_CREATE, id, str(params.get("name")), new LinkedHashMap<>(params), user);
+        return get(id);
+    }
+
+    public ManagedProxyGroupDetailDto update(String proxyGroupId, ProxyGroupUpsertReqDto req, TokenUserInfo user) {
+        String token = zabbixUserService.getSuperAdminToken();
+        Map<String, Object> current = fetchRaw(token, proxyGroupId);
+        Map<String, Object> params = toParams(req, false);
+        Map<String, Object> payload = new LinkedHashMap<>(params);
+        payload.put("fields", new ArrayList<>(params.keySet()));
+        params.put("proxy_groupid", proxyGroupId);
+        proxyGroupService.update(token, params);
+        String name = params.containsKey("name") ? str(params.get("name")) : str(current.get("name"));
+        writeLog(ZabbixChangeLog.ACTION_UPDATE, proxyGroupId, name, payload, user);
+        return get(proxyGroupId);
+    }
+
+    public DiscoveryDeleteResDto delete(List<String> ids, TokenUserInfo user) {
+        List<String> clean = ids == null ? List.of()
+                : ids.stream().filter(x -> x != null && !x.isBlank()).map(String::trim).distinct().toList();
+        if (clean.isEmpty()) throw new ApiError(ErrorCode.PROXY_GROUP_IDS_REQUIRED);
+        String token = zabbixUserService.getSuperAdminToken();
+        List<Map<String, Object>> rows = proxyGroupService.getRaw(token, select(clean));
+        if (rows.size() < clean.size()) throw new ApiError(ErrorCode.PROXY_GROUP_NOT_FOUND);
+
+        // 🔴 하나라도 쓰이면 아무것도 지우지 않는다 — 프록시와 배정 호스트를 함께 알려 준다(Zabbix 원문은 하나만).
+        Map<String, String> names = new HashMap<>();
+        List<String> blocked = new ArrayList<>();
+        for (Map<String, Object> g : rows) {
+            String id = str(g.get("proxy_groupid"));
+            names.put(id, str(g.get("name")));
+            List<String> uses = new ArrayList<>();
+            List<String> proxies = members(g.get("proxies")).stream().map(Member::name).toList();
+            if (!proxies.isEmpty()) uses.add("프록시 " + String.join(", ", proxies));
+            long hosts = countHosts(token, id);
+            if (hosts > 0) uses.add("호스트 " + hosts + "개");
+            if (!uses.isEmpty()) blocked.add(str(g.get("name")) + " ← " + String.join(" · ", uses));
+        }
+        if (!blocked.isEmpty()) throw new ApiError(ErrorCode.PROXY_GROUP_IN_USE.getCode() + ": " + String.join(" / ", blocked));
+        proxyGroupService.delete(token, clean);
+        for (String id : clean) writeLog(ZabbixChangeLog.ACTION_DELETE, id, names.get(id), Map.of(), user);
+        return new DiscoveryDeleteResDto(clean, clean.size());
+    }
+
+    // ====================================================================
+    // 내부
+    // ====================================================================
+
+    /** 생성은 빈 지연·최소 온라인을 생략(Zabbix 기본값), 수정은 보낸 빈 값도 그대로 보내 Zabbix가 거부하게 한다. */
+    static Map<String, Object> toParams(ProxyGroupUpsertReqDto req, boolean creating) {
+        Map<String, Object> p = new LinkedHashMap<>();
+        if (req.getName() != null) {
+            if (req.getName().isBlank()) throw new ApiError(ErrorCode.PROXY_GROUP_NAME_REQUIRED);
+            p.put("name", req.getName().trim());
+        }
+        // 범위·형식(10~900초, 1~1000)은 Zabbix 원문이 정확하다 — 여기서 다시 검사하지 않는다.
+        putGiven(p, "failover_delay", req.getFailoverDelay(), creating);
+        putGiven(p, "min_online", req.getMinOnline(), creating);
+        if (req.getDescription() != null) p.put("description", req.getDescription());
+        return p;
+    }
+
+    static ManagedProxyGroupDto toDto(Map<String, Object> g, long hostCount) {
+        List<Member> proxies = members(g.get("proxies"));
+        int online = (int) asList(g.get("proxies")).stream().filter(p -> PROXY_ONLINE.equals(str(p.get("state")))).count();
+        return new ManagedProxyGroupDto(str(g.get("proxy_groupid")), str(g.get("name")), strOrEmpty(g.get("failover_delay")),
+                strOrEmpty(g.get("min_online")), strOrEmpty(g.get("description")), label(GROUP_STATES, intOr(g.get("state"), 0)),
+                proxies.size(), online, hostCount, proxies);
+    }
+
+    private static Map<String, Object> select(List<String> ids) {
+        Map<String, Object> params = new LinkedHashMap<>();
+        params.put("output", "extend");
+        params.put("selectProxies", List.of("proxyid", "name", "state"));
+        params.put("sortfield", "name");
+        if (ids != null) params.put("proxy_groupids", ids);
+        return params;
+    }
+
+    private Map<String, Object> fetchRaw(String token, String proxyGroupId) {
+        List<Map<String, Object>> rows = proxyGroupService.getRaw(token, select(List.of(proxyGroupId)));
+        if (rows.isEmpty()) throw new ApiError(ErrorCode.PROXY_GROUP_NOT_FOUND);
+        return rows.get(0);
+    }
+
+    private long countHosts(String token, String proxyGroupId) {
+        Map<String, Object> params = new LinkedHashMap<>();
+        params.put("countOutput", true);
+        params.put("proxy_groupids", List.of(proxyGroupId));
+        return hostService.countRaw(token, params);
+    }
+
+    private static List<Member> members(Object raw) {
+        List<Member> out = new ArrayList<>();
+        for (Map<String, Object> p : asList(raw)) {
+            out.add(new Member(str(p.get("proxyid")), str(p.get("name")), label(PROXY_STATES, intOr(p.get("state"), 0))));
+        }
+        out.sort(Comparator.comparing((Member m) -> m.name() == null ? "" : m.name().toLowerCase()));
+        return out;
+    }
+
+    private void writeLog(String action, String entityId, String entityName, Map<String, Object> payload, TokenUserInfo user) {
+        try {
+            changeLogRepository.save(ZabbixChangeLog.builder()
+                    .entityType(ZabbixChangeLog.ENTITY_PROXY_GROUP).entityId(entityId).entityName(entityName)
+                    .action(action).payload(payload).actor(actorResolver.resolve(user)).build());
+        } catch (Exception e) {
+            log.warn("zabbix_change_log insert failed (PROXY_GROUP action={}, id={}): {}", action, entityId, e.getMessage());
+        }
+    }
+
+    private static String label(String[] names, int code) {
+        return code >= 0 && code < names.length ? names[code] : names[0];
+    }
+
+    private static void putGiven(Map<String, Object> params, String key, String value, boolean creating) {
+        if (value == null || (creating && value.isBlank())) return;
+        params.put(key, value.trim());
+    }
+
+    private static boolean isBlank(String s) { return s == null || s.isBlank(); }
+
+    @SuppressWarnings("unchecked")
+    private static List<Map<String, Object>> asList(Object v) {
+        if (v instanceof List<?> l) return (List<Map<String, Object>>) l;
+        return List.of();
+    }
+
+    private static String str(Object v) { return v == null ? null : String.valueOf(v); }
+
+    private static String strOrEmpty(Object v) { return v == null ? "" : String.valueOf(v); }
+
+    private static int intOr(Object v, int def) {
+        if (v instanceof Number n) return n.intValue();
+        if (v == null) return def;
+        try { return Integer.parseInt(String.valueOf(v).trim()); } catch (NumberFormatException e) { return def; }
+    }
+}
