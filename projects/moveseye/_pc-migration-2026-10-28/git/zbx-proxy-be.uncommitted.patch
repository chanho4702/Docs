+    @PutMapping("/{proxyid}")
+    public ApiResult<ManagedProxyDetailDto> update(@CurrentUser TokenUserInfo u, @PathVariable String proxyid,
+            @RequestBody ProxyUpsertReqDto req) {
+        AdminAccessChecker.requireAdmin(u);
