+
+    @Operation(summary = "프록시 상세", description = "관리자 전용. 편집 프리필 + 사용처(직접·그룹 경유 호스트 각 최대 500, 디스커버리 규칙). "
+            + "🔴 PSK 식별자·값은 내려가지 않는다(Zabbix 쓰기 전용 — pskConfigured로 사용 여부만).")
+    @GetMapping("/{proxyid}")
