+@Tag(name = "ZabbixProxyManage")
+@SecurityRequirement(name = "bearer")
+@VisitorIdCheck
+@RequiredArgsConstructor
+public class ZabbixProxyManageController {
+
+    private final ZabbixProxyManageService service;
+
+    @Operation(summary = "프록시 목록", description = "관리자 전용. 전체(이름순). 상태 UNKNOWN·OFFLINE·ONLINE, 버전 7.0.13 형식, "
+            + "직접 배정 호스트 수(hostCount)·그룹 경유 호스트 수(assignedHostCount).")
+    @GetMapping
