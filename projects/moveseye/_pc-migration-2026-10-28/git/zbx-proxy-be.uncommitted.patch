+package com.dmove.moveseye.zabbixadmin.dto;
+
+import com.fasterxml.jackson.annotation.JsonProperty;
+import io.swagger.v3.oas.annotations.media.Schema;
+import java.util.Map;
+import lombok.Getter;
+import lombok.Setter;
+
+/**
+ * 프록시 생성/수정 — 키는 Zabbix 원본(snake). 🔴 필드가 전부 래퍼 타입이다(안 보냄과 0/빈 값 구분, 수정은 보낸 것만).
+ *
+ * <ul>
+ *   <li>모드별 TLS는 서비스가 정규화한다 — 액티브면 {@code tls_connect=1}, 패시브면 {@code tls_accept=1}(Zabbix가 반대편 값을 거부).</li>
+ *   <li>{@code tls_psk_identity}·{@code tls_psk} — 비우면 유지, 채우면 교체. PSK를 새로 켤 때는 둘 다 필수.</li>
+ *   <li>{@code timeouts} — 키는 {@code timeout_}을 뺀 이름. {@code custom_timeouts=1}이면 빠진 키를 현재 값 → 전역 값으로 채운다.</li>
+ * </ul>
+ * 검증은 서비스가 한다(Bean Validation 없음 — 메시지 축을 하나로).
+ */
+@Getter
+@Setter
+@Schema(description = "프록시 생성/수정 요청")
+public class ProxyUpsertReqDto {
+
+    private String name;
+    @JsonProperty("operating_mode")
+    @Schema(description = "0 액티브 · 1 패시브(생성 필수)")
+    private Integer operatingMode;
+    private String description;
+    @JsonProperty("proxy_groupid")
+    @Schema(description = "프록시 그룹 ID. \"0\" 또는 빈 값이면 그룹에서 뺀다")
+    private String proxyGroupid;
+    @JsonProperty("local_address")
+    @Schema(description = "그룹 소속이면 필수")
+    private String localAddress;
+    @JsonProperty("local_port")
+    private String localPort;
+    @JsonProperty("allowed_addresses")
+    @Schema(description = "액티브만")
+    private String allowedAddresses;
+    @Schema(description = "패시브만")
+    private String address;
+    @Schema(description = "패시브만")
+    private String port;
+    @JsonProperty("tls_connect")
+    @Schema(description = "패시브: 1 없음 · 2 PSK · 4 인증서")
+    private Integer tlsConnect;
+    @JsonProperty("tls_accept")
+    @Schema(description = "액티브: 비트 합(1 없음 · 2 PSK · 4 인증서)")
+    private Integer tlsAccept;
+    @JsonProperty("tls_issuer")
+    private String tlsIssuer;
+    @JsonProperty("tls_subject")
+    private String tlsSubject;
+    @JsonProperty("tls_psk_identity")
+    @Schema(description = "비우면 유지")
+    private String tlsPskIdentity;
+    @JsonProperty("tls_psk")
+    @Schema(description = "비우면 유지(16진 32자 이상)")
+    private String tlsPsk;
+    @JsonProperty("custom_timeouts")
+    @Schema(description = "0 전역 값 사용 · 1 프록시 전용")
+    private Integer customTimeouts;
+    @Schema(description = "키: zabbix_agent·simple_check·snmp_agent·external_check·db_monitor·http_agent·ssh_agent·telnet_agent·script·browser")
+    private Map<String, String> timeouts;
+}
