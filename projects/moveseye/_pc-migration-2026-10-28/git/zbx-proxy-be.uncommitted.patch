diff --git a/engine-zabbix/src/main/java/com/dmove/moveseye/zabbix/proxy/ZabbixProxyGroupServiceImpl.java b/engine-zabbix/src/main/java/com/dmove/moveseye/zabbix/proxy/ZabbixProxyGroupServiceImpl.java
