+package com.dmove.moveseye.zabbix.proxy;
+
+import java.util.List;
+import java.util.Map;
+
+/**
+ * 프록시 그룹 계약 — {@code proxygroup.*}(Zabbix 7.0 신설). 그룹 안의 프록시 중 하나가 죽으면 호스트를 다른 프록시로 넘긴다.
+ *
+ * <p>실측(7.0.6): {@code proxygroup.create}는 {@code proxies} 인자가 없다(소속은 프록시 쪽 {@code proxy_groupid}).
+ * 프록시나 배정 호스트가 있으면 delete를 거부한다. {@code min_online} 1~1000, {@code failover_delay} 10~900초. 가공 없음.
+ */
+public interface ZabbixProxyGroupService {
+
+    /** proxygroup.get 원시 호출 — selectProxies(count 지원)는 호출자가. */
+    List<Map<String, Object>> getRaw(String authToken, Map<String, Object> params);
+
+    /** proxygroup.create — 생성 proxy_groupid(없으면 null). */
+    String create(String authToken, Map<String, Object> params);
+
+    /** proxygroup.update — params에 proxy_groupid. */
+    void update(String authToken, Map<String, Object> params);
+
+    /** proxygroup.delete — 프록시·배정 호스트가 있으면 Zabbix가 거부. */
+    void delete(String authToken, List<String> proxyGroupIds);
+}
