+  local_port?: string;
+  allowed_addresses?: string;
+  address?: string;
+  port?: string;
+  tls_connect: number;
+  /** 액티브 수락 방식 — 비트를 체크 상자 배열로. */
+  tls_accept: number[];
+  tls_psk_identity?: string;
+  tls_psk?: string;
+  tls_issuer?: string;
+  tls_subject?: string;
+  custom_timeouts: boolean;
+  timeouts: TProxyTimeouts;
+};
+
+const CREATE_DEFAULTS: FormValues = {
+  name: "",
+  operating_mode: MODE_ACTIVE,
+  proxy_groupid: undefined,
+  local_port: "10051",
+  address: "127.0.0.1",
+  port: "10051",
+  tls_connect: TLS_NONE,
+  tls_accept: [TLS_NONE],
+  custom_timeouts: false,
+  timeouts: {},
+};
+
+const bitsToList = (bits: number) => [TLS_NONE, TLS_PSK, TLS_CERT].filter((b) => (bits & b) !== 0);
+const listToBits = (list: number[] | undefined) => (list ?? []).reduce((acc, b) => acc | b, 0);
+
+export const detailToValues = (d: TManagedProxyDetail): FormValues => {
+  const s = d.summary;
+  return {
+    name: s.name,
+    operating_mode: s.operatingMode,
+    description: s.description,
+    proxy_groupid: s.proxyGroup?.id,
+    local_address: s.localAddress,
+    local_port: s.localPort || "10051",
+    allowed_addresses: s.allowedAddresses,
+    address: s.address || "127.0.0.1",
+    port: s.port || "10051",
+    tls_connect: s.tlsConnect || TLS_NONE,
+    tls_accept: bitsToList(s.tlsAccept || TLS_NONE),
+    tls_psk_identity: "",
+    tls_psk: "",
+    tls_issuer: d.tlsIssuer,
+    tls_subject: d.tlsSubject,
+    custom_timeouts: s.customTimeouts,
+    timeouts: { ...d.timeouts },
+  };
+};
+
+/**
+ * 모드를 바꿀 때 암호화 방식을 새 모드 쪽으로 옮긴다 — 🔴 그대로 두면 새 모드 쪽 값(기본 "없음")으로 저장돼 암호화가 조용히 꺼진다.
+ * 패시브→액티브: 연결 방식 하나를 받을 방식으로. 액티브→패시브: 받을 방식 중 PSK > 인증서 > 없음 순으로 하나.
+ */
+export const carryTlsAcrossModes = (to: TProxyMode, connect: number, accept: number[]) =>
+  to === MODE_ACTIVE
+    ? { tls_accept: [connect || TLS_NONE] }
+    : { tls_connect: accept.includes(TLS_PSK) ? TLS_PSK : accept.includes(TLS_CERT) ? TLS_CERT : TLS_NONE };
+
+/** 결과 TLS가 PSK를 쓰는가 — 액티브는 수락 비트, 패시브는 연결 방식. */
+const usesPsk = (mode: TProxyMode, connect: number, accept: number[]) =>
+  mode === MODE_ACTIVE ? accept.includes(TLS_PSK) : connect === TLS_PSK;
+const usesCert = (mode: TProxyMode, connect: number, accept: number[]) =>
+  mode === MODE_ACTIVE ? accept.includes(TLS_CERT) : connect === TLS_CERT;
+
+/**
+ * 폼 → 요청. 🔴 모드에 맞는 쪽만 보낸다(BE도 정규화하지만 보내는 값이 화면과 같게).
+ * PSK 식별자·값은 비우면 보내지 않는다(= 유지). 타임아웃은 사용자 지정일 때만.
+ * 🔴 포트는 생성이면 비울 때 생략(Zabbix 기본값), 수정이면 빈 값을 그대로 보낸다 — 화면에서 비웠는데 옛 값이 남지 않게(BE·Zabbix가 거부).
+ */
+export const valuesToRequest = (v: FormValues, isEdit = false): TProxyUpsertReq => {
+  const optional = (value: string | undefined) => {
+    const trimmed = (value ?? "").trim();
+    return isEdit ? trimmed : trimmed || undefined;
+  };
+  const active = v.operating_mode === MODE_ACTIVE;
+  const group = v.proxy_groupid && v.proxy_groupid !== NO_GROUP ? v.proxy_groupid : NO_GROUP;
+  const body: TProxyUpsertReq = {
+    name: v.name.trim(),
+    operating_mode: v.operating_mode,
+    description: v.description ?? "",
+    proxy_groupid: group,
+    tls_issuer: v.tls_issuer ?? "",
+    tls_subject: v.tls_subject ?? "",
+    custom_timeouts: v.custom_timeouts ? 1 : 0,
+  };
+  if (group !== NO_GROUP) {
+    body.local_address = (v.local_address ?? "").trim();
+    body.local_port = optional(v.local_port);
+  }
+  if (active) {
+    body.allowed_addresses = (v.allowed_addresses ?? "").trim();
+    body.tls_accept = listToBits(v.tls_accept) || TLS_NONE;
+  } else {
+    body.address = optional(v.address);
+    body.port = optional(v.port);
+    body.tls_connect = v.tls_connect || TLS_NONE;
+  }
+  if (v.tls_psk_identity) body.tls_psk_identity = v.tls_psk_identity;
+  if (v.tls_psk) body.tls_psk = v.tls_psk.trim();
+  if (v.custom_timeouts) {
+    const timeouts: TProxyTimeouts = {};
+    PROXY_TIMEOUT_KEYS.forEach((k) => {
+      const value = (v.timeouts?.[k] ?? "").trim();
+      if (value) timeouts[k] = value;
+    });
+    body.timeouts = timeouts;
+  }
+  return body;
+};
+
+type ProxyFormDrawerProps = {
+  open: boolean;
+  /** 수정 대상(목록 행). 없으면 생성. */
+  proxy?: TManagedProxy;
+  onClose: () => void;
+};
+
+// 프록시 생성/수정 패널 — 기본 · 암호화 · 타임아웃 · 사용처(수정만) 탭. 계약 §2~§3.
+// 🔴 PSK는 응답에 없다(Zabbix 쓰기 전용). 지금 PSK를 쓰는 중이면 "비우면 유지"(모드를 바꿔도 결과가 PSK면 Zabbix가 유지),
+//    지금 PSK가 없는데 켜면 식별자·값이 필수다 — 그 구분을 칸 위 안내와 필수 표시로 보여 준다.
+// 🔴 모드를 바꾸면 암호화 방식을 새 모드 쪽으로 옮겨 담는다(carryTlsAcrossModes) — BE도 생략을 PROXY_TLS_REQUIRED로 막는다.
+const ProxyFormDrawer = ({ open, proxy, onClose }: ProxyFormDrawerProps) => {
+  const { t } = useTranslation();
+  const [form] = Form.useForm<FormValues>();
+  const [tab, setTab] = useState<string>(TAB.BASIC);
+  const isEdit = !!proxy;
+  const { data: detail, isFetching: detailFetching, isError: isDetailError, error: detailError } = useProxyDetail(
+    open && isEdit ? proxy?.proxyid : undefined
+  );
+  const { data: options } = useProxyOptions(open);
+  // 🔴 수정은 "이 프록시"의 상세를 이번에 새로 받은 뒤에만 — 다른 프록시의 상세, 받는 중인 옛 캐시로 채우지 않는다.
+  const detailReady = !isEdit || (!!detail && detail.summary.proxyid === proxy?.proxyid && !detailFetching);
+  const { mutate: create, isPending: creating } = useCreateProxy();
+  const { mutate: update, isPending: updating } = useUpdateProxy();
+
+  const mode = (Form.useWatch("operating_mode", form) ?? MODE_ACTIVE) as TProxyMode;
+  const group = Form.useWatch("proxy_groupid", form);
+  const tlsConnect = Form.useWatch("tls_connect", form) ?? TLS_NONE;
+  const tlsAccept = Form.useWatch("tls_accept", form) ?? [TLS_NONE];
+  const customTimeouts = Form.useWatch("custom_timeouts", form) ?? false;
+
+  const inGroup = !!group && group !== NO_GROUP;
+  const wantsPsk = usesPsk(mode, tlsConnect, tlsAccept);
+  const wantsCert = usesCert(mode, tlsConnect, tlsAccept);
+  // 지금 저장된 PSK를 그대로 쓸 수 있는가 — 이미 PSK를 쓰는 중이면(모드를 바꿔도 결과가 PSK인 한 Zabbix가 유지한다).
+  const pskKeepable = isEdit && !!detail?.summary.pskConfigured;
+
+  /**
+   * 폼을 채운 대상 — 🔴 한 번 채운 뒤에는 상세가 다시 조회돼도(창 복귀 등, 상태·마지막 접속만 바뀌어도) 다시 채우지 않는다.
+   * 다시 채우면 편집 중인 값과 PSK 입력이 조용히 사라진다. 닫으면 초기화한다(Web 시나리오 폼과 같은 규칙).
+   */
+  const filledFor = useRef<string | null>(null);
+  /**
+   * 모드별로 마지막에 고른 암호화 방식 — 🔴 액티브 [없음·PSK·인증서] → 패시브(하나로 줄어듦) → 액티브로 돌아올 때
+   * 줄어든 값이 아니라 원래 고른 값을 되돌린다(왕복만 했는데 인증서 허용이 사라지지 않게).
+   */
+  const tlsByMode = useRef<{ accept?: number[]; connect?: number }>({});
+
+  useEffect(() => {
+    if (!open) {
+      filledFor.current = null;
+      tlsByMode.current = {};
+      return;
+    }
+    const key = isEdit ? `edit:${proxy?.proxyid}` : "create";
+    if (filledFor.current === key) return;
+    // 🔴 채우기 전에 항상 비운다 — 폼 인스턴스는 닫아도 남아, 생성에 이전 생성·편집의 설명·허용 주소·PSK가 섞인다.
+    form.resetFields();
+    tlsByMode.current = {};
+    if (!isEdit) {
+      setTab(TAB.BASIC);
+      form.setFieldsValue(CREATE_DEFAULTS);
+      filledFor.current = key;
+      return;
+    }
+    if (!detailReady || !detail) return;
+    setTab(TAB.BASIC);
+    form.setFieldsValue(detailToValues(detail));
+    filledFor.current = key;
+  }, [open, isEdit, proxy?.proxyid, detail, detailReady, form]);
+
+  /** 사용자 지정을 켤 때 빈 칸을 전역 값으로 채운다 — Zabbix는 10개 전부를 요구한다. */
+  const handleCustomToggle = (checked: boolean) => {
+    if (!checked) return;
+    const current = form.getFieldValue("timeouts") as TProxyTimeouts | undefined;
+    const next: TProxyTimeouts = { ...(current ?? {}) };
+    PROXY_TIMEOUT_KEYS.forEach((k) => {
+      if (!next[k]) next[k] = options?.globalTimeouts?.[k] ?? "";
+    });
+    form.setFieldValue("timeouts", next);
+  };
+
+  /** 모드 전환 — 떠나는 모드의 선택을 기억하고, 돌아오면 되돌리고, 처음 가는 모드면 암호화를 옮겨 담는다. */
+  const handleValuesChange = (changed: Partial<FormValues>, all: FormValues) => {
+    if (changed.operating_mode === undefined) return;
+    const to = changed.operating_mode;
+    const accept = all.tls_accept ?? [];
+    if (to === MODE_ACTIVE) {
+      tlsByMode.current.connect = all.tls_connect;
+      const remembered = tlsByMode.current.accept;
+      form.setFieldsValue(remembered ? { tls_accept: remembered } : carryTlsAcrossModes(to, all.tls_connect, accept));
+    } else {
+      tlsByMode.current.accept = accept;
+      const remembered = tlsByMode.current.connect;
+      form.setFieldsValue(remembered !== undefined ? { tls_connect: remembered } : carryTlsAcrossModes(to, all.tls_connect, accept));
+    }
+  };
+
+  const handleSubmit = (v: FormValues) => {
+    if (!detailReady) return;
+    const body = valuesToRequest(v, isEdit);
+    const onError = (err: unknown) => message.error(proxyErrorMessage(err, t), 8);
+    const onSuccess = () => {
+      message.success(isEdit ? t("proxy_management.update_success") : t("proxy_management.create_success"));
+      onClose();
+    };
+    if (isEdit && proxy) update({ proxyid: proxy.proxyid, body }, { onSuccess, onError });
+    else create(body, { onSuccess, onError });
+  };
+
+  // 숨은 탭의 칸에서 검증이 실패하면 그 탭을 연다(탭은 forceRender라 값은 살아 있다).
+  const handleFailed = ({ errorFields }: { errorFields: { name: (string | number)[] }[] }) => {
+    const first = errorFields[0]?.name?.[0];
+    if (first === "timeouts") setTab(TAB.TIMEOUTS);
+    else if (typeof first === "string" && TLS_FIELDS.has(first)) setTab(TAB.TLS);
+    else setTab(TAB.BASIC);
+  };
+
+  const pskRequired = wantsPsk && !pskKeepable;
+  const pskHint = !wantsPsk ? undefined : pskKeepable ? t("proxy_management.psk_keep_hint") : t("proxy_management.psk_required_hint");
+
+  const items = [
+    {
+      key: TAB.BASIC,
+      label: t("proxy_management.tab_basic"),
+      forceRender: true,
+      children: (
+        <>
+          <Form.Item name="name" label={t("proxy_management.name")} tooltip={t("proxy_management.name_hint")}
+            rules={[{ required: true, whitespace: true, message: t("proxy_management.name_required") }]}>
+            <Input maxLength={128} autoComplete="off" />
+          </Form.Item>
+          <Form.Item name="operating_mode" label={t("proxy_management.col_mode")} extra={t(`proxy_management.mode_hint.${mode}`)}>
+            <Radio.Group
+              optionType="button"
+              options={[
+                { value: MODE_ACTIVE, label: t("proxy_management.mode.0") },
+                { value: MODE_PASSIVE, label: t("proxy_management.mode.1") },
+              ]}
+            />
+          </Form.Item>
+          {isEdit && detail && detail.summary.operatingMode !== mode ? (
+            <Alert className="mb-4" type="warning" showIcon message={t("proxy_management.mode_change_warning")} />
+          ) : null}
+          {mode === MODE_ACTIVE ? (
+            <Form.Item name="allowed_addresses" label={t("proxy_management.allowed_addresses")} extra={t("proxy_management.allowed_addresses_hint")}>
+              <Input placeholder="10.0.0.5, proxy.example.com" />
+            </Form.Item>
+          ) : (
+            <Flex gap={12}>
+              <Form.Item name="address" label={t("proxy_management.address")} className="flex-1"
+                rules={[{ required: true, whitespace: true, message: t("proxy_management.address_required") }]}>
+                <Input placeholder="10.0.0.9" />
+              </Form.Item>
+              <Form.Item name="port" label={t("proxy_management.port")} className="w-[120px]">
+                <Input placeholder="10051" />
+              </Form.Item>
+            </Flex>
+          )}
+          <Form.Item name="proxy_groupid" label={t("proxy_management.proxy_group")} extra={t("proxy_management.proxy_group_hint")}>
+            <Select allowClear placeholder={t("proxy_management.no_group")}
+              options={(options?.proxyGroups ?? []).map((g) => ({ value: g.id, label: g.name ?? g.id }))} />
+          </Form.Item>
+          {inGroup ? (
+            <Flex gap={12}>
+              <Form.Item name="local_address" label={t("proxy_management.local_address")} className="flex-1"
+                tooltip={t("proxy_management.local_address_hint")}
+                rules={[{ required: true, whitespace: true, message: t("proxy_management.local_address_required") }]}>
+                <Input placeholder="10.0.0.5" />
+              </Form.Item>
+              <Form.Item name="local_port" label={t("proxy_management.port")} className="w-[120px]">
+                <Input placeholder="10051" />
+              </Form.Item>
+            </Flex>
+          ) : null}
+          <Form.Item name="description" label={t("proxy_management.description")}>
+            <Input.TextArea autoSize={{ minRows: 2, maxRows: 6 }} />
+          </Form.Item>
+        </>
+      ),
+    },
+    {
+      key: TAB.TLS,
+      label: t("proxy_management.tab_tls"),
+      forceRender: true,
+      children: (
+        <>
+          {mode === MODE_ACTIVE ? (
+            <Form.Item name="tls_accept" label={t("proxy_management.tls_accept")} extra={t("proxy_management.tls_accept_hint")}
+              rules={[{ required: true, type: "array", min: 1, message: t("proxy_management.tls_accept_required") }]}>
+              <Checkbox.Group
+                options={[
+                  { value: TLS_NONE, label: t("proxy_management.tls.none") },
+                  { value: TLS_PSK, label: t("proxy_management.tls.psk") },
+                  { value: TLS_CERT, label: t("proxy_management.tls.cert") },
+                ]}
+              />
+            </Form.Item>
+          ) : (
+            <Form.Item name="tls_connect" label={t("proxy_management.tls_connect")} extra={t("proxy_management.tls_connect_hint")}>
+              <Radio.Group
+                options={[
+                  { value: TLS_NONE, label: t("proxy_management.tls.none") },
+                  { value: TLS_PSK, label: t("proxy_management.tls.psk") },
+                  { value: TLS_CERT, label: t("proxy_management.tls.cert") },
+                ]}
+              />
+            </Form.Item>
+          )}
+          {wantsPsk ? (
+            <>
+              {pskHint ? <Alert className="mb-4" type={pskRequired ? "warning" : "info"} showIcon message={pskHint} /> : null}
+              <Form.Item name="tls_psk_identity" label={t("proxy_management.psk_identity")}
+                rules={pskRequired ? [{ required: true, message: t("proxy_management.psk_identity_required") }] : []}>
+                <Input autoComplete="off" placeholder={pskKeepable ? t("proxy_management.psk_set_placeholder") : undefined} />
+              </Form.Item>
+              <Form.Item name="tls_psk" label={t("proxy_management.psk")} extra={t("proxy_management.psk_format_hint")}
+                rules={[
+                  ...(pskRequired ? [{ required: true, message: t("proxy_management.psk_required") }] : []),
+                  { pattern: /^([0-9a-fA-F]{32,})?$/, message: t("proxy_management.psk_format_invalid") },
+                ]}>
+                <Input.Password autoComplete="new-password" placeholder={pskKeepable ? t("proxy_management.psk_set_placeholder") : undefined} />
+              </Form.Item>
+            </>
+          ) : null}
+          {wantsCert ? (
+            <>
+              <Form.Item name="tls_issuer" label={t("proxy_management.tls_issuer")} tooltip={t("proxy_management.tls_cert_field_hint")}>
+                <Input placeholder="CN=Root CA,O=Example" />
+              </Form.Item>
+              <Form.Item name="tls_subject" label={t("proxy_management.tls_subject")} tooltip={t("proxy_management.tls_cert_field_hint")}>
+                <Input placeholder="CN=proxy-seoul,O=Example" />
+              </Form.Item>
+            </>
+          ) : null}
+        </>
+      ),
+    },
+    {
+      key: TAB.TIMEOUTS,
+      label: t("proxy_management.tab_timeouts"),
+      forceRender: true,
+      children: (
+        <>
+          <Form.Item name="custom_timeouts" label={t("proxy_management.custom_timeouts")} valuePropName="checked"
+            extra={t("proxy_management.custom_timeouts_hint")}>
+            <Switch onChange={handleCustomToggle} />
+          </Form.Item>
+          {customTimeouts ? (
+            <Flex gap={12} wrap>
+              {PROXY_TIMEOUT_KEYS.map((k) => (
+                <Form.Item key={k} name={["timeouts", k]} label={t(`proxy_management.timeout_labels.${k}`)} className="w-[180px]"
+                  rules={[{ required: true, whitespace: true, message: t("proxy_management.timeout_required") }]}>
+                  <Input placeholder={options?.globalTimeouts?.[k] ?? "3s"} />
+                </Form.Item>
+              ))}
+            </Flex>
+          ) : (
+            <Text type="secondary">{t("proxy_management.global_timeouts_in_use")}</Text>
+          )}
+        </>
+      ),
+    },
+    ...(isEdit
+      ? [{ key: TAB.USAGE, label: t("proxy_management.tab_usage"), children: detail ? <UsageTab detail={detail} /> : null }]
+      : []),
+  ];
+
+  return (
+    <ResizableDrawer
+      title={isEdit ? t("proxy_management.edit_title") : t("proxy_management.create_title")}
+      open={open}
+      onClose={onClose}
+      storageKey="zabbix-proxy-form"
+      defaultWidth={720}
+      destroyOnClose
+      footer={
+        <Flex justify="end" gap={8}>
+          <Button onClick={onClose}>{t("proxy_management.cancel")}</Button>
+          <Button type="primary" loading={creating || updating} disabled={!detailReady} onClick={() => form.submit()}>
+            {t("proxy_management.save")}
+          </Button>
+        </Flex>
+      }
+    >
+      {isEdit && isDetailError ? <Alert className="mb-3" type="error" showIcon message={proxyErrorMessage(detailError, t)} /> : null}
+      <Form form={form} layout="vertical" onFinish={handleSubmit} onFinishFailed={handleFailed} onValuesChange={handleValuesChange}
+        disabled={!detailReady}>
+        <Tabs activeKey={tab} onChange={setTab} items={items} />
+      </Form>
+    </ResizableDrawer>
+  );
+};
+
+const HostList = ({ hosts }: { hosts: TProxyHostRef[] }) => {
+  const { t } = useTranslation();
+  if (hosts.length === 0) return <Empty image={Empty.PRESENTED_IMAGE_SIMPLE} description={t("proxy_management.no_hosts")} />;
+  return (
+    <List
+      size="small"
+      bordered
+      className="max-h-[280px] overflow-auto"
+      dataSource={hosts}
+      renderItem={(h) => (
+        <List.Item>
+          <Link to={PATH_ZABBIX_MANAGEMENT.hostManagementDetail.replace(":hostid", h.hostid)}>{h.name}</Link>
+        </List.Item>
+      )}
+    />
+  );
+};
+
+/** 사용처 — 읽기 전용(배정은 호스트 관리에서). 개수는 summary가 정본이고 목록은 500건까지. */
+const UsageTab = ({ detail }: { detail: TManagedProxyDetail }) => {
+  const { t } = useTranslation();
+  return (
+    <Flex vertical gap={16}>
+      <Text type="secondary">{t("proxy_management.usage_hint")}</Text>
+      {detail.hostsTruncated ? <Alert type="info" showIcon message={t("proxy_management.hosts_truncated")} /> : null}
+      <Flex vertical gap={6}>
+        <Text strong>{t("proxy_management.direct_hosts", { count: detail.summary.hostCount })}</Text>
+        <HostList hosts={detail.hosts} />
+      </Flex>
+      {detail.summary.proxyGroup ? (
+        <Flex vertical gap={6}>
+          <Text strong>{t("proxy_management.assigned_hosts", { count: detail.summary.assignedHostCount })}</Text>
+          <Text type="secondary" className="text-xs">{t("proxy_management.assigned_hosts_hint")}</Text>
+          <HostList hosts={detail.assignedHosts} />
+        </Flex>
+      ) : null}
+      <Flex vertical gap={6}>
+        <Text strong>{t("proxy_management.discovery_rules", { count: detail.discoveryRules.length })}</Text>
+        {detail.discoveryRules.length === 0 ? (
+          <Text type="secondary">{t("proxy_management.no_discovery_rules")}</Text>
+        ) : (
+          <List size="small" bordered dataSource={detail.discoveryRules} renderItem={(r) => <List.Item>{r.name ?? r.id}</List.Item>} />
+        )}
+      </Flex>
+    </Flex>
+  );
+};
+
+export default ProxyFormDrawer;
diff --git a/src/pages/zabbix-management/proxy/ProxyGroupFormDrawer.tsx b/src/pages/zabbix-management/proxy/ProxyGroupFormDrawer.tsx
new file mode 100644
index 0000000..32502fb
--- /dev/null
+++ b/src/pages/zabbix-management/proxy/ProxyGroupFormDrawer.tsx
@@ -0,0 +1,154 @@
+import ResizableDrawer from "@/components/Drawer/ResizableDrawer";
+import { PATH_ZABBIX_MANAGEMENT } from "@/constants/routes";
+import { useCreateProxyGroup, useProxyGroupDetail, useUpdateProxyGroup } from "@/hooks/useZabbixProxy";
+import { TManagedProxyGroup, TProxyGroupUpsertReq } from "@/types/zabbix-proxy";
+import { Alert, Button, Divider, Empty, Flex, Form, Input, List, Tag, Typography, message } from "antd";
+import { useEffect, useRef } from "react";
+import { useTranslation } from "react-i18next";
+import { Link } from "react-router-dom";
+import { proxyErrorMessage } from "./proxyErrors";
+import { PROXY_STATE_COLORS } from "./ProxyTab";
+
+const { Text } = Typography;
+
+type FormValues = { name: string; failover_delay?: string; min_online?: string; description?: string };
+
+const CREATE_DEFAULTS: FormValues = { name: "", failover_delay: "1m", min_online: "1", description: "" };
+
+type ProxyGroupFormDrawerProps = {
+  open: boolean;
+  /** 수정 대상(목록 행). 없으면 생성. */
+  group?: TManagedProxyGroup;
+  onClose: () => void;
+};
+
+// 프록시 그룹 생성/수정 패널 — 이름·장애 조치 지연·최소 온라인·설명 + 소속 프록시·배정 호스트(읽기 전용). 계약 §6.
+// 범위(지연 10초~15분, 최소 온라인 1~1000)는 Zabbix가 원문으로 알려 준다 — 여기서는 비었는지만 본다.
+const ProxyGroupFormDrawer = ({ open, group, onClose }: ProxyGroupFormDrawerProps) => {
+  const { t } = useTranslation();
+  const [form] = Form.useForm<FormValues>();
+  const isEdit = !!group;
+  const { data: detail, isFetching, isError, error } = useProxyGroupDetail(open && isEdit ? group?.proxyGroupId : undefined);
+  // 🔴 이번에 새로 받은 "이 그룹"의 상세로만 채운다(옛 캐시로 채우면 최신 설정을 옛 값으로 덮는다).
+  const detailReady = !isEdit || (!!detail && detail.summary.proxyGroupId === group?.proxyGroupId && !isFetching);
+  const { mutate: create, isPending: creating } = useCreateProxyGroup();
+  const { mutate: update, isPending: updating } = useUpdateProxyGroup();
+  /** 🔴 한 번 채운 뒤에는 상세가 다시 조회돼도 다시 채우지 않는다(편집 중 값 보호). 닫으면 초기화. */
+  const filledFor = useRef<string | null>(null);
+
+  useEffect(() => {
+    if (!open) {
+      filledFor.current = null;
+      return;
+    }
+    const key = isEdit ? `edit:${group?.proxyGroupId}` : "create";
+    if (filledFor.current === key) return;
+    form.resetFields(); // 폼 인스턴스는 닫아도 남는다 — 이전 값이 섞이지 않게 항상 비우고 채운다.
+    if (!isEdit) {
+      form.setFieldsValue(CREATE_DEFAULTS);
+      filledFor.current = key;
+      return;
+    }
+    if (!detailReady || !detail) return;
+    const s = detail.summary;
+    form.setFieldsValue({ name: s.name, failover_delay: s.failoverDelay, min_online: s.minOnline, description: s.description });
+    filledFor.current = key;
+  }, [open, isEdit, group?.proxyGroupId, detail, detailReady, form]);
+
+  const handleSubmit = (v: FormValues) => {
+    if (!detailReady) return;
+    // 생성은 빈 값 생략(Zabbix 기본값), 수정은 빈 값을 그대로 — 비웠는데 옛 값이 남지 않게(Zabbix가 거부).
+    const optional = (value: string | undefined) => {
+      const trimmed = (value ?? "").trim();
+      return isEdit ? trimmed : trimmed || undefined;
+    };
+    const body: TProxyGroupUpsertReq = {
+      name: v.name.trim(),
+      failover_delay: optional(v.failover_delay),
+      min_online: optional(v.min_online),
+      description: v.description ?? "",
+    };
+    const onError = (err: unknown) => message.error(proxyErrorMessage(err, t), 8);
+    const onSuccess = () => {
+      message.success(isEdit ? t("proxy_management.group_update_success") : t("proxy_management.group_create_success"));
+      onClose();
+    };
+    if (isEdit && group) update({ proxyGroupId: group.proxyGroupId, body }, { onSuccess, onError });
+    else create(body, { onSuccess, onError });
+  };
+
+  return (
+    <ResizableDrawer
+      title={isEdit ? t("proxy_management.group_edit_title") : t("proxy_management.group_create_title")}
+      open={open}
+      onClose={onClose}
+      storageKey="zabbix-proxy-group-form"
+      defaultWidth={560}
+      destroyOnClose
+      footer={
+        <Flex justify="end" gap={8}>
+          <Button onClick={onClose}>{t("proxy_management.cancel")}</Button>
+          <Button type="primary" loading={creating || updating} disabled={!detailReady} onClick={() => form.submit()}>
+            {t("proxy_management.save")}
+          </Button>
+        </Flex>
+      }
+    >
+      {isEdit && isError ? <Alert className="mb-3" type="error" showIcon message={proxyErrorMessage(error, t)} /> : null}
+      <Form form={form} layout="vertical" onFinish={handleSubmit} disabled={!detailReady}>
+        <Form.Item name="name" label={t("proxy_management.name")}
+          rules={[{ required: true, whitespace: true, message: t("proxy_management.name_required") }]}>
+          <Input maxLength={255} autoComplete="off" />
+        </Form.Item>
+        <Flex gap={12}>
+          <Form.Item name="failover_delay" label={t("proxy_management.col_failover_delay")} tooltip={t("proxy_management.failover_delay_hint")} className="flex-1">
+            <Input placeholder="1m" />
+          </Form.Item>
+          <Form.Item name="min_online" label={t("proxy_management.col_min_online")} tooltip={t("proxy_management.min_online_hint")} className="flex-1">
+            <Input placeholder="1" />
+          </Form.Item>
+        </Flex>
+        <Form.Item name="description" label={t("proxy_management.description")}>
+          <Input.TextArea autoSize={{ minRows: 2, maxRows: 6 }} />
+        </Form.Item>
+      </Form>
+
+      {isEdit && detail ? (
+        <>
+          <Divider />
+          <Flex vertical gap={12}>
+            <Text type="secondary">{t("proxy_management.group_members_hint")}</Text>
+            <Text strong>{t("proxy_management.group_proxies", { count: detail.summary.proxyCount })}</Text>
+            {detail.summary.proxies.length === 0 ? (
+              <Empty image={Empty.PRESENTED_IMAGE_SIMPLE} description={t("proxy_management.no_proxies")} />
+            ) : (
+              <List size="small" bordered dataSource={detail.summary.proxies}
+                renderItem={(p) => (
+                  <List.Item>
+                    <Flex justify="space-between" className="w-full">
+                      <Text>{p.name}</Text>
+                      <Tag color={PROXY_STATE_COLORS[p.state]}>{t(`proxy_management.state.${p.state}`)}</Tag>
+                    </Flex>
+                  </List.Item>
+                )} />
+            )}
+            <Text strong>{t("proxy_management.group_hosts", { count: detail.summary.hostCount })}</Text>
+            {detail.hostsTruncated ? <Alert type="info" showIcon message={t("proxy_management.hosts_truncated")} /> : null}
+            {detail.hosts.length === 0 ? (
+              <Empty image={Empty.PRESENTED_IMAGE_SIMPLE} description={t("proxy_management.no_hosts")} />
+            ) : (
+              <List size="small" bordered className="max-h-[280px] overflow-auto" dataSource={detail.hosts}
+                renderItem={(h) => (
+                  <List.Item>
+                    <Link to={PATH_ZABBIX_MANAGEMENT.hostManagementDetail.replace(":hostid", h.hostid)}>{h.name}</Link>
+                  </List.Item>
+                )} />
+            )}
+          </Flex>
+        </>
+      ) : null}
+    </ResizableDrawer>
+  );
+};
+
+export default ProxyGroupFormDrawer;
diff --git a/src/pages/zabbix-management/proxy/ProxyGroupTab.tsx b/src/pages/zabbix-management/proxy/ProxyGroupTab.tsx
new file mode 100644
index 0000000..6d8353c
--- /dev/null
+++ b/src/pages/zabbix-management/proxy/ProxyGroupTab.tsx
@@ -0,0 +1,189 @@
+import DmoveTable from "@/components/Table/DmoveTable";
+import DmoveTableFilter from "@/components/Table/DmoveTableFilter";
+import { QueryParamKeys } from "@/enums/common";
+import { useQueryParams } from "@/hooks/useQueryParams";
+import useTableColumns from "@/hooks/useTableColumns";
+import { useDeleteProxyGroups, useProxyGroupList } from "@/hooks/useZabbixProxy";
+import { SelectFilter } from "@/types/commons";
+import { TManagedProxyGroup, TProxyGroupState } from "@/types/zabbix-proxy";
+import { Alert, Button, Flex, List, Modal, Space, Tag, Tooltip, Typography, message } from "antd";
+import { useMemo, useState } from "react";
+import { useTranslation } from "react-i18next";
+import ProxyGroupFormDrawer from "./ProxyGroupFormDrawer";
+import { proxyErrorMessage } from "./proxyErrors";
+import { PROXY_STATE_COLORS } from "./ProxyTab";
+
+const { Text } = Typography;
+
+const GROUP_STATE_COLORS: Record<TProxyGroupState, string> = {
+  ONLINE: "success",
+  DEGRADING: "warning",
+  RECOVERING: "processing",
+  OFFLINE: "error",
+  UNKNOWN: "default",
+};
+const GROUP_STATES: TProxyGroupState[] = ["ONLINE", "DEGRADING", "RECOVERING", "OFFLINE", "UNKNOWN"];
+
+// 프록시 그룹 탭 — 목록(화면 거름)·생성·수정·삭제. 계약 §6.
+// 소속 프록시는 프록시 폼의 그룹 선택으로 바꾼다(Zabbix도 그렇다). 프록시나 배정 호스트가 있으면 삭제를 막는다.
+const ProxyGroupTab = () => {
+  const { t } = useTranslation();
+  const { params } = useQueryParams();
+  const keyword = (params.keyword ?? "").toLowerCase();
+  const stateFilter = params[QueryParamKeys.STATUS];
+
+  const { data, isLoading, isError, error } = useProxyGroupList();
+  const { mutate: deleteGroups, isPending: deleting } = useDeleteProxyGroups();
+  const [drawerOpen, setDrawerOpen] = useState(false);
+  const [editTarget, setEditTarget] = useState<TManagedProxyGroup | undefined>();
+  const [deleteTarget, setDeleteTarget] = useState<TManagedProxyGroup | undefined>();
+
+  const rows = useMemo(() => {
+    let all = data ?? [];
+    if (stateFilter) all = all.filter((g) => g.state === stateFilter);
+    if (keyword) all = all.filter((g) => g.name.toLowerCase().includes(keyword) || (g.description ?? "").toLowerCase().includes(keyword));
+    return all;
+  }, [data, keyword, stateFilter]);
+
+  const filter: SelectFilter[] = [
+    {
+      name: t("proxy_management.filter_state"),
+      key: QueryParamKeys.STATUS,
+      options: GROUP_STATES.map((s) => ({ label: t(`proxy_management.group_state.${s}`), value: s })),
+    },
+  ];
+
+  const openEdit = (g?: TManagedProxyGroup) => {
+    setEditTarget(g);
+    setDrawerOpen(true);
+  };
+
+  const confirmDelete = () => {
+    if (!deleteTarget) return;
+    deleteGroups([deleteTarget.proxyGroupId], {
+      onSuccess: () => {
+        message.success(t("proxy_management.group_delete_success"));
+        setDeleteTarget(undefined);
+      },
+      onError: (err: unknown) => message.error(proxyErrorMessage(err, t), 8),
+    });
+  };
+
+  const blockedReason = (g: TManagedProxyGroup) => {
+    if (g.proxyCount > 0) return t("proxy_management.group_delete_blocked_proxies", { count: g.proxyCount });
+    if (g.hostCount > 0) return t("proxy_management.group_delete_blocked_hosts", { count: g.hostCount });
+    return undefined;
+  };
+
+  const { columns } = useTableColumns<TManagedProxyGroup>([
+    {
+      key: "col_pg_name",
+      title: "proxy_management.col_name",
+      dataIndex: "name",
+      sorter: false,
+      render: (_: unknown, g: TManagedProxyGroup) => (
+        <Flex vertical>
+          <Text strong>{g.name}</Text>
+          {g.description ? <Text type="secondary" className="text-xs" ellipsis={{ tooltip: g.description }}>{g.description}</Text> : null}
+        </Flex>
+      ),
+    },
+    {
+      key: "col_pg_state",
+      title: "proxy_management.col_state",
+      sorter: false,
+      width: 130,
+      render: (_: unknown, g: TManagedProxyGroup) => (
+        <Tooltip title={t(`proxy_management.group_state_hint.${g.state}`)}>
+          <Tag color={GROUP_STATE_COLORS[g.state]}>{t(`proxy_management.group_state.${g.state}`)}</Tag>
+        </Tooltip>
+      ),
+    },
+    {
+      key: "col_pg_proxies",
+      title: "proxy_management.col_proxies",
+      sorter: false,
+      render: (_: unknown, g: TManagedProxyGroup) => (
+        <Flex vertical gap={4}>
+          <Text>{t("proxy_management.online_of_total", { online: g.onlineProxyCount, total: g.proxyCount })}</Text>
+          <Space size={2} wrap>
+            {g.proxies.map((p) => (
+              <Tag key={p.proxyid} color={PROXY_STATE_COLORS[p.state]}>{p.name}</Tag>
+            ))}
+          </Space>
+        </Flex>
+      ),
+    },
+    {
+      key: "col_pg_min_online",
+      title: "proxy_management.col_min_online",
+      sorter: false,
+      width: 110,
+      render: (_: unknown, g: TManagedProxyGroup) => g.minOnline,
+    },
+    {
+      key: "col_pg_failover",
+      title: "proxy_management.col_failover_delay",
+      sorter: false,
+      width: 130,
+      render: (_: unknown, g: TManagedProxyGroup) => g.failoverDelay,
+    },
+    {
+      key: "col_pg_hosts",
+      title: "proxy_management.col_hosts",
+      sorter: false,
+      width: 100,
+      render: (_: unknown, g: TManagedProxyGroup) => g.hostCount,
+    },
+    {
+      key: "col_pg_actions",
+      title: "proxy_management.col_actions",
+      sorter: false,
+      width: 130,
+      render: (_: unknown, g: TManagedProxyGroup) => {
+        const reason = blockedReason(g);
+        const del = (
+          <Button size="small" danger disabled={!!reason} onClick={() => setDeleteTarget(g)}>
+            {t("proxy_management.delete")}
+          </Button>
+        );
+        return (
+          <Space size={4}>
+            <Button size="small" onClick={() => openEdit(g)}>{t("proxy_management.edit")}</Button>
+            {reason ? <Tooltip title={reason}>{del}</Tooltip> : del}
+          </Space>
+        );
+      },
+    },
+  ]);
+
+  return (
+    <Flex vertical gap={12}>
+      <Alert type="info" showIcon message={t("proxy_management.group_desc")} />
+      <DmoveTableFilter
+        filter={filter}
+        placeholder={t("proxy_management.group_search_placeholder")}
+        button={<Button type="primary" onClick={() => openEdit(undefined)}>{t("proxy_management.group_create")}</Button>}
+      />
+      {isError ? <Alert type="error" showIcon message={proxyErrorMessage(error, t)} /> : null}
+      <DmoveTable loading={isLoading} columns={columns} dataSource={rows} rowKey="proxyGroupId" showPagination={false} tableId="zabbix-proxy-groups" />
+
+      <ProxyGroupFormDrawer open={drawerOpen} group={editTarget} onClose={() => setDrawerOpen(false)} />
+
+      <Modal
+        title={t("proxy_management.group_delete_title")}
+        open={!!deleteTarget}
+        onCancel={() => setDeleteTarget(undefined)}
+        onOk={confirmDelete}
+        okText={t("proxy_management.delete")}
+        okButtonProps={{ danger: true, loading: deleting }}
+        cancelText={t("proxy_management.cancel")}
+        destroyOnHidden
+      >
+        <List size="small" bordered dataSource={deleteTarget ? [deleteTarget] : []} renderItem={(g) => <List.Item>{g.name}</List.Item>} />
+      </Modal>
+    </Flex>
+  );
+};
+
+export default ProxyGroupTab;
