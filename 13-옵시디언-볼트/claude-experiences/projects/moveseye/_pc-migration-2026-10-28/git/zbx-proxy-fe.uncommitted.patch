diff --git a/src/hooks/useZabbixProxy.ts b/src/hooks/useZabbixProxy.ts
new file mode 100644
index 0000000..e63fff0
--- /dev/null
+++ b/src/hooks/useZabbixProxy.ts
@@ -0,0 +1,114 @@
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+
+import { HOST_MANAGE_QUERY_KEY, PROXY_QUERY_KEY } from "@/constants/queryKey";
+import ZabbixProxyService from "@/services/zabbix-proxy.api";
+import {
+  TManagedProxy,
+  TManagedProxyDetail,
+  TManagedProxyGroup,
+  TManagedProxyGroupDetail,
+  TProxyGroupUpsertReq,
+  TProxyOptions,
+  TProxyUpsertReq,
+} from "@/types/zabbix-proxy";
+import useDmoveQuery from "./useDmoveQuery";
+
+// Zabbix 관리 > 프록시·프록시 그룹 react-query 훅. 언랩 깊이는 Web 시나리오 훅과 같다(조회 data = payload).
+// 🔴 프록시와 그룹은 서로의 화면에 이름·개수로 보인다(프록시 행의 그룹, 그룹 행의 소속 프록시) — 어느 쪽을 바꾸든 둘 다 무효화한다.
+
+export const useProxyList = () =>
+  useDmoveQuery<TManagedProxy[]>({
+    queryKey: [PROXY_QUERY_KEY.LIST],
+    queryFn: () => ZabbixProxyService.getProxyList(),
+  });
+
+export const useProxyOptions = (enabled: boolean) =>
+  useDmoveQuery<TProxyOptions>({
+    queryKey: [PROXY_QUERY_KEY.OPTIONS],
+    queryFn: () => ZabbixProxyService.getProxyOptions(),
+    enabled,
+  });
+
+/**
+ * 🔴 상세는 폼을 열 때마다 새로 받는다(staleTime 0 + refetchOnMount always) — 폼은 열 때 한 번만 채우므로,
+ * 1분 캐시(전역 staleTime)로 채우면 그 사이 바뀐 암호화·PSK 상태를 옛 값으로 되돌려 저장할 수 있다. 폼은 받는 중에는 채우지 않는다.
+ */
+export const useProxyDetail = (proxyid: string | undefined) =>
+  useDmoveQuery<TManagedProxyDetail>({
+    queryKey: [PROXY_QUERY_KEY.DETAIL, proxyid],
+    queryFn: () => ZabbixProxyService.getProxyDetail(proxyid as string),
+    enabled: !!proxyid,
+    staleTime: 0,
+    refetchOnMount: "always",
+  });
+
+export const useProxyGroupList = () =>
+  useDmoveQuery<TManagedProxyGroup[]>({
+    queryKey: [PROXY_QUERY_KEY.GROUP_LIST],
+    queryFn: () => ZabbixProxyService.getProxyGroupList(),
+  });
+
+/** 프록시 상세와 같은 이유로 열 때마다 새로 받는다. */
+export const useProxyGroupDetail = (proxyGroupId: string | undefined) =>
+  useDmoveQuery<TManagedProxyGroupDetail>({
+    queryKey: [PROXY_QUERY_KEY.GROUP_DETAIL, proxyGroupId],
+    queryFn: () => ZabbixProxyService.getProxyGroupDetail(proxyGroupId as string),
+    enabled: !!proxyGroupId,
+    staleTime: 0,
+    refetchOnMount: "always",
+  });
+
+const invalidateProxies = (queryClient: ReturnType<typeof useQueryClient>) => {
+  Object.values(PROXY_QUERY_KEY).forEach((key) => queryClient.invalidateQueries({ queryKey: [key] }));
+  // 호스트 등록 폼의 프록시 선택지도 같은 목록이다.
+  queryClient.invalidateQueries({ queryKey: [HOST_MANAGE_QUERY_KEY.PROXIES] });
+};
+
+export const useCreateProxy = () => {
+  const queryClient = useQueryClient();
+  return useMutation({
+    mutationFn: (body: TProxyUpsertReq) => ZabbixProxyService.createProxy(body),
+    onSuccess: () => invalidateProxies(queryClient),
+  });
+};
+
+export const useUpdateProxy = () => {
+  const queryClient = useQueryClient();
+  return useMutation({
+    mutationFn: ({ proxyid, body }: { proxyid: string; body: TProxyUpsertReq }) => ZabbixProxyService.updateProxy(proxyid, body),
+    onSuccess: () => invalidateProxies(queryClient),
+  });
+};
+
+export const useDeleteProxies = () => {
+  const queryClient = useQueryClient();
+  return useMutation({
+    mutationFn: (ids: string[]) => ZabbixProxyService.deleteProxies(ids),
+    onSuccess: () => invalidateProxies(queryClient),
+  });
+};
+
+export const useCreateProxyGroup = () => {
+  const queryClient = useQueryClient();
+  return useMutation({
+    mutationFn: (body: TProxyGroupUpsertReq) => ZabbixProxyService.createProxyGroup(body),
+    onSuccess: () => invalidateProxies(queryClient),
+  });
+};
+
+export const useUpdateProxyGroup = () => {
+  const queryClient = useQueryClient();
+  return useMutation({
+    mutationFn: ({ proxyGroupId, body }: { proxyGroupId: string; body: TProxyGroupUpsertReq }) =>
+      ZabbixProxyService.updateProxyGroup(proxyGroupId, body),
+    onSuccess: () => invalidateProxies(queryClient),
+  });
+};
+
+export const useDeleteProxyGroups = () => {
+  const queryClient = useQueryClient();
+  return useMutation({
+    mutationFn: (ids: string[]) => ZabbixProxyService.deleteProxyGroups(ids),
+    onSuccess: () => invalidateProxies(queryClient),
+  });
+};
