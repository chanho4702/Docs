diff --git a/src/services/zabbix-proxy.api.ts b/src/services/zabbix-proxy.api.ts
new file mode 100644
index 0000000..b1fefa5
--- /dev/null
+++ b/src/services/zabbix-proxy.api.ts
@@ -0,0 +1,65 @@
+// Zabbix 관리 > 프록시·프록시 그룹(기본 기능, 관리자 전용) — 계약: _workspace/features/zabbix-config/proxy/contract_proxy.md.
+// 조회는 useDmoveQuery가 2겹째 언랩, 변경은 envelope 실패 시 throw(그래프·Web 시나리오와 같은 규약).
+// 업무 오류는 errorCode `PROXY_*`·`PROXY_GROUP_*` + message 상세(예: 사용 중인 호스트 이름), Zabbix 거부는 원문.
+import API from "./axiosInstance";
+import { unwrapEnvelope, ZabbixManageApiError } from "./zabbix-item-template.api";
+import { TZabbixManageEnvelope } from "@/types/zabbix-item-template";
+import {
+  TManagedProxy,
+  TManagedProxyDetail,
+  TManagedProxyGroup,
+  TManagedProxyGroupDetail,
+  TProxyDeleteRes,
+  TProxyGroupUpsertReq,
+  TProxyOptions,
+  TProxyUpsertReq,
+} from "@/types/zabbix-proxy";
+
+const proxiesUrl = "zabbix-manage/proxies";
+const groupsUrl = "zabbix-manage/proxy-groups";
+
+export { ZabbixManageApiError };
+
+const getProxyList = (): Promise<TManagedProxy[]> => API.get(proxiesUrl);
+
+const getProxyOptions = (): Promise<TProxyOptions> => API.get(`${proxiesUrl}/options`);
+
+const getProxyDetail = (proxyid: string): Promise<TManagedProxyDetail> => API.get(`${proxiesUrl}/${proxyid}`);
+
+const createProxy = (body: TProxyUpsertReq): Promise<TManagedProxyDetail> =>
+  API.post<unknown, TZabbixManageEnvelope<TManagedProxyDetail>>(proxiesUrl, body).then(unwrapEnvelope);
+
+const updateProxy = (proxyid: string, body: TProxyUpsertReq): Promise<TManagedProxyDetail> =>
+  API.put<unknown, TZabbixManageEnvelope<TManagedProxyDetail>>(`${proxiesUrl}/${proxyid}`, body).then(unwrapEnvelope);
+
+const deleteProxies = (ids: string[]): Promise<TProxyDeleteRes> =>
+  API.delete<unknown, TZabbixManageEnvelope<TProxyDeleteRes>>(proxiesUrl, { data: { ids } }).then(unwrapEnvelope);
+
+const getProxyGroupList = (): Promise<TManagedProxyGroup[]> => API.get(groupsUrl);
+
+const getProxyGroupDetail = (proxyGroupId: string): Promise<TManagedProxyGroupDetail> => API.get(`${groupsUrl}/${proxyGroupId}`);
+
+const createProxyGroup = (body: TProxyGroupUpsertReq): Promise<TManagedProxyGroupDetail> =>
+  API.post<unknown, TZabbixManageEnvelope<TManagedProxyGroupDetail>>(groupsUrl, body).then(unwrapEnvelope);
+
+const updateProxyGroup = (proxyGroupId: string, body: TProxyGroupUpsertReq): Promise<TManagedProxyGroupDetail> =>
+  API.put<unknown, TZabbixManageEnvelope<TManagedProxyGroupDetail>>(`${groupsUrl}/${proxyGroupId}`, body).then(unwrapEnvelope);
+
+const deleteProxyGroups = (ids: string[]): Promise<TProxyDeleteRes> =>
+  API.delete<unknown, TZabbixManageEnvelope<TProxyDeleteRes>>(groupsUrl, { data: { ids } }).then(unwrapEnvelope);
+
+const ZabbixProxyService = {
+  getProxyList,
+  getProxyOptions,
+  getProxyDetail,
+  createProxy,
+  updateProxy,
+  deleteProxies,
+  getProxyGroupList,
+  getProxyGroupDetail,
+  createProxyGroup,
+  updateProxyGroup,
+  deleteProxyGroups,
+};
+
+export default ZabbixProxyService;
diff --git a/src/types/zabbix-proxy.ts b/src/types/zabbix-proxy.ts
new file mode 100644
index 0000000..62c9ca2
--- /dev/null
+++ b/src/types/zabbix-proxy.ts
@@ -0,0 +1,126 @@
+// Zabbix 관리 > 프록시·프록시 그룹(기본 기능, 관리자 전용). 계약: _workspace/features/zabbix-config/proxy/contract_proxy.md.
+// 응답은 camelCase, 요청은 Zabbix 원본 키(snake) — 그래프·Web 시나리오와 같은 관례.
+
+export type TProxyMode = 0 | 1;
+export type TProxyState = "UNKNOWN" | "OFFLINE" | "ONLINE";
+export type TProxyCompatibility = "UNDEFINED" | "CURRENT" | "OUTDATED" | "UNSUPPORTED";
+export type TProxyGroupState = "UNKNOWN" | "OFFLINE" | "RECOVERING" | "ONLINE" | "DEGRADING";
+
+export type TProxyRef = { id: string; name: string | null };
+export type TProxyHostRef = { hostid: string; name: string };
+
+/** 프록시 타임아웃 10종 — 키는 Zabbix 필드에서 `timeout_`을 뗀 이름. */
+export const PROXY_TIMEOUT_KEYS = [
+  "zabbix_agent",
+  "simple_check",
+  "snmp_agent",
+  "external_check",
+  "db_monitor",
+  "http_agent",
+  "ssh_agent",
+  "telnet_agent",
+  "script",
+  "browser",
+] as const;
+export type TProxyTimeoutKey = (typeof PROXY_TIMEOUT_KEYS)[number];
+export type TProxyTimeouts = Partial<Record<TProxyTimeoutKey, string>>;
+
+/** GET /zabbix-manage/proxies 행. */
+export type TManagedProxy = {
+  proxyid: string;
+  name: string;
+  operatingMode: TProxyMode;
+  proxyGroup: TProxyRef | null;
+  address: string;
+  port: string;
+  allowedAddresses: string;
+  localAddress: string;
+  localPort: string;
+  description: string;
+  state: TProxyState;
+  /** epoch 초. 접속한 적 없으면 null. */
+  lastAccess: number | null;
+  version: string | null;
+  compatibility: TProxyCompatibility;
+  /** 직접 배정된 호스트 수(monitored_by=1). */
+  hostCount: number;
+  /** 그룹을 통해 지금 이 프록시가 맡은 호스트 수. */
+  assignedHostCount: number;
+  tlsConnect: number;
+  tlsAccept: number;
+  /** 지금 PSK를 쓰는 중 — 값은 내려오지 않는다(Zabbix 쓰기 전용). */
+  pskConfigured: boolean;
+  customTimeouts: boolean;
+};
+
+/** GET /zabbix-manage/proxies/{proxyid}. */
+export type TManagedProxyDetail = {
+  summary: TManagedProxy;
+  tlsIssuer: string;
+  tlsSubject: string;
+  timeouts: TProxyTimeouts;
+  hosts: TProxyHostRef[];
+  assignedHosts: TProxyHostRef[];
+  hostsTruncated: boolean;
+  discoveryRules: TProxyRef[];
+};
+
+/** GET /zabbix-manage/proxies/options. */
+export type TProxyOptions = {
+  proxyGroups: TProxyRef[];
+  globalTimeouts: TProxyTimeouts;
+};
+
+/** POST·PUT /zabbix-manage/proxies — 수정은 보낸 것만. */
+export type TProxyUpsertReq = {
+  name?: string;
+  operating_mode?: TProxyMode;
+  description?: string;
+  proxy_groupid?: string;
+  local_address?: string;
+  local_port?: string;
+  allowed_addresses?: string;
+  address?: string;
+  port?: string;
+  tls_connect?: number;
+  tls_accept?: number;
+  tls_issuer?: string;
+  tls_subject?: string;
+  /** 비우면 유지. */
+  tls_psk_identity?: string;
+  /** 비우면 유지. */
+  tls_psk?: string;
+  custom_timeouts?: 0 | 1;
+  timeouts?: TProxyTimeouts;
+};
+
+export type TProxyGroupMember = { proxyid: string; name: string; state: TProxyState };
+
+/** GET /zabbix-manage/proxy-groups 행. */
+export type TManagedProxyGroup = {
+  proxyGroupId: string;
+  name: string;
+  failoverDelay: string;
+  minOnline: string;
+  description: string;
+  state: TProxyGroupState;
+  proxyCount: number;
+  onlineProxyCount: number;
+  hostCount: number;
+  proxies: TProxyGroupMember[];
+};
+
+export type TManagedProxyGroupDetail = {
+  summary: TManagedProxyGroup;
+  hosts: TProxyHostRef[];
+  hostsTruncated: boolean;
+};
+
+export type TProxyGroupUpsertReq = {
+  name?: string;
+  failover_delay?: string;
+  min_online?: string;
+  description?: string;
+};
+
+export type TProxyDeleteRes = { ids: string[]; count: number };
