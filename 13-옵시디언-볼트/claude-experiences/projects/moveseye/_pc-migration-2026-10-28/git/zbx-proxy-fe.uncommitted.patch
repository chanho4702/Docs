+++ b/src/pages/zabbix-management/proxy/ProxyTab.tsx
@@ -0,0 +1,277 @@
+import DmoveTable from "@/components/Table/DmoveTable";
+import DmoveTableFilter from "@/components/Table/DmoveTableFilter";
+import { DATE_TIME_FORMATS, QueryParamKeys } from "@/enums/common";
+import { useQueryParams } from "@/hooks/useQueryParams";
+import useTableColumns from "@/hooks/useTableColumns";
+import { useDeleteProxies, useProxyGroupList, useProxyList } from "@/hooks/useZabbixProxy";
+import { SelectFilter } from "@/types/commons";
+import { TManagedProxy, TProxyState } from "@/types/zabbix-proxy";
+import { Alert, Button, Flex, List, Modal, Space, Tag, Tooltip, Typography, message } from "antd";
+import dayjs from "dayjs";
+import { useMemo, useState } from "react";
+import { useTranslation } from "react-i18next";
+import ProxyFormDrawer from "./ProxyFormDrawer";
+import { proxyErrorMessage } from "./proxyErrors";
+
+const { Text } = Typography;
+
+export const PROXY_STATE_COLORS: Record<TProxyState, string> = { ONLINE: "success", OFFLINE: "error", UNKNOWN: "default" };
+const STATES: TProxyState[] = ["ONLINE", "OFFLINE", "UNKNOWN"];
+const TLS_PSK = 2;
+const TLS_CERT = 4;
+
+/** 암호화 표시 — 액티브는 받는 방식(비트), 패시브는 연결 방식 하나. */
+export const tlsLabels = (p: Pick<TManagedProxy, "operatingMode" | "tlsConnect" | "tlsAccept">): ("none" | "psk" | "cert")[] => {
+  if (p.operatingMode === 1) {
+    return [p.tlsConnect === TLS_PSK ? "psk" : p.tlsConnect === TLS_CERT ? "cert" : "none"];
+  }
+  const out: ("none" | "psk" | "cert")[] = [];
+  if (p.tlsAccept & 1) out.push("none");
+  if (p.tlsAccept & TLS_PSK) out.push("psk");
+  if (p.tlsAccept & TLS_CERT) out.push("cert");
+  return out.length > 0 ? out : ["none"];
+};
+
+// 프록시 탭 — 목록(화면 거름)·생성·수정·삭제. 계약 §1~§4.
+// 삭제는 직접 감시 호스트·디스커버리 규칙이 있으면 BE가 하나도 지우지 않고 PROXY_IN_USE로 이름을 알려 준다 —
+// 화면도 호스트가 있는 행은 미리 막고 이유를 툴팁으로 보여 준다(규칙은 상세에서만 보이므로 BE 판정이 정본).
+const ProxyTab = () => {
+  const { t } = useTranslation();
+  const { params } = useQueryParams();
+  const keyword = (params.keyword ?? "").toLowerCase();
+  const stateFilter = params[QueryParamKeys.STATUS];
+  const modeFilter = params[QueryParamKeys.PROXY_MODE];
+  const groupFilter = params[QueryParamKeys.PROXY_GROUP_ID];
+
+  const { data, isLoading, isError, error } = useProxyList();
+  const { data: groups } = useProxyGroupList();
+  const { mutate: deleteProxies, isPending: deleting } = useDeleteProxies();
+  const [drawerOpen, setDrawerOpen] = useState(false);
+  const [editTarget, setEditTarget] = useState<TManagedProxy | undefined>();
+  const [deleteTargets, setDeleteTargets] = useState<TManagedProxy[]>([]);
+
+  const rows = useMemo(() => {
+    let all = data ?? [];
+    if (stateFilter) all = all.filter((p) => p.state === stateFilter);
+    if (modeFilter === "0" || modeFilter === "1") all = all.filter((p) => String(p.operatingMode) === modeFilter);
+    if (groupFilter) all = all.filter((p) => (groupFilter === "0" ? !p.proxyGroup : p.proxyGroup?.id === groupFilter));
+    if (keyword) {
+      all = all.filter((p) =>
+        [p.name, p.address, p.allowedAddresses, p.localAddress, p.description].some((v) => (v ?? "").toLowerCase().includes(keyword))
+      );
+    }
+    return all;
+  }, [data, keyword, stateFilter, modeFilter, groupFilter]);
+
+  const filter: SelectFilter[] = [
+    {
+      name: t("proxy_management.filter_mode"),
+      key: QueryParamKeys.PROXY_MODE,
+      options: [
+        { label: t("proxy_management.mode.0"), value: "0" },
+        { label: t("proxy_management.mode.1"), value: "1" },
+      ],
+    },
+    {
+      name: t("proxy_management.filter_state"),
+      key: QueryParamKeys.STATUS,
+      options: STATES.map((s) => ({ label: t(`proxy_management.state.${s}`), value: s })),
+    },
+    {
+      name: t("proxy_management.filter_group"),
+      key: QueryParamKeys.PROXY_GROUP_ID,
+      options: [
+        { label: t("proxy_management.no_group"), value: "0" },
+        ...(groups ?? []).map((g) => ({ label: g.name, value: g.proxyGroupId })),
+      ],
+    },
+  ];
+
+  const openEdit = (p?: TManagedProxy) => {
+    setEditTarget(p);
+    setDrawerOpen(true);
+  };
+
+  const confirmDelete = () => {
+    if (deleteTargets.length === 0) return;
+    deleteProxies(
+      deleteTargets.map((p) => p.proxyid),
+      {
+        onSuccess: () => {
+          message.success(t("proxy_management.delete_success"));
+          setDeleteTargets([]);
+        },
+        onError: (err: unknown) => message.error(proxyErrorMessage(err, t), 8),
+      }
+    );
+  };
+
+  const handleBatchDelete = (ids: React.Key[]) => {
+    const idSet = new Set(ids.map(String));
+    setDeleteTargets(rows.filter((p) => idSet.has(p.proxyid) && p.hostCount === 0));
+  };
+
+  const { columns } = useTableColumns<TManagedProxy>([
+    {
+      key: "col_px_name",
+      title: "proxy_management.col_name",
+      dataIndex: "name",
+      sorter: false,
+      render: (_: unknown, p: TManagedProxy) => (
+        <Flex vertical>
+          <Text strong>{p.name}</Text>
+          {p.description ? <Text type="secondary" className="text-xs" ellipsis={{ tooltip: p.description }}>{p.description}</Text> : null}
+        </Flex>
+      ),
+    },
+    {
+      key: "col_px_mode",
+      title: "proxy_management.col_mode",
+      sorter: false,
+      width: 100,
+      render: (_: unknown, p: TManagedProxy) => <Tag>{t(`proxy_management.mode.${p.operatingMode}`)}</Tag>,
+    },
+    {
+      key: "col_px_state",
+      title: "proxy_management.col_state",
+      sorter: false,
+      width: 190,
+      render: (_: unknown, p: TManagedProxy) => (
+        <Flex vertical>
+          <Tag color={PROXY_STATE_COLORS[p.state]} className="self-start">{t(`proxy_management.state.${p.state}`)}</Tag>
+          <Text type="secondary" className="text-xs">
+            {p.lastAccess
+              ? t("proxy_management.last_access", { time: dayjs.unix(p.lastAccess).format(DATE_TIME_FORMATS.FULL) })
+              : t("proxy_management.never_connected")}
+          </Text>
+        </Flex>
+      ),
+    },
+    {
+      key: "col_px_version",
+      title: "proxy_management.col_version",
+      sorter: false,
+      width: 140,
+      render: (_: unknown, p: TManagedProxy) => (
+        <Space size={4} wrap>
+          <Text>{p.version ?? "-"}</Text>
+          {p.compatibility === "OUTDATED" || p.compatibility === "UNSUPPORTED" ? (
+            <Tooltip title={t(`proxy_management.compatibility_hint.${p.compatibility}`)}>
+              <Tag color={p.compatibility === "UNSUPPORTED" ? "error" : "warning"}>{t(`proxy_management.compatibility.${p.compatibility}`)}</Tag>
+            </Tooltip>
+          ) : null}
+        </Space>
+      ),
+    },
+    {
+      key: "col_px_group",
+      title: "proxy_management.col_group",
+      sorter: false,
+      width: 150,
+      render: (_: unknown, p: TManagedProxy) => (p.proxyGroup ? <Text>{p.proxyGroup.name ?? p.proxyGroup.id}</Text> : <Text type="secondary">-</Text>),
+    },
+    {
+      key: "col_px_address",
+      title: "proxy_management.col_address",
+      sorter: false,
+      width: 200,
+      render: (_: unknown, p: TManagedProxy) =>
+        p.operatingMode === 1 ? (
+          <Text className="text-xs">{`${p.address}:${p.port}`}</Text>
+        ) : (
+          <Tooltip title={t("proxy_management.allowed_addresses_hint")}>
+            <Text className="text-xs" type={p.allowedAddresses ? undefined : "secondary"}>
+              {p.allowedAddresses || t("proxy_management.any_address")}
+            </Text>
+          </Tooltip>
+        ),
+    },
+    {
+      key: "col_px_hosts",
+      title: "proxy_management.col_hosts",
+      sorter: false,
+      width: 110,
+      render: (_: unknown, p: TManagedProxy) => (
+        <Tooltip title={t("proxy_management.host_count_hint", { direct: p.hostCount, assigned: p.assignedHostCount })}>
+          <Text>{p.assignedHostCount > 0 ? `${p.hostCount} + ${p.assignedHostCount}` : p.hostCount}</Text>
+        </Tooltip>
+      ),
+    },
+    {
+      key: "col_px_tls",
+      title: "proxy_management.col_encryption",
+      sorter: false,
+      width: 140,
+      render: (_: unknown, p: TManagedProxy) => (
+        <Space size={2} wrap>
+          {tlsLabels(p).map((l) => (
+            <Tag key={l} color={l === "none" ? undefined : "blue"}>{t(`proxy_management.tls.${l}`)}</Tag>
+          ))}
+        </Space>
+      ),
+    },
+    {
+      key: "col_px_actions",
+      title: "proxy_management.col_actions",
+      sorter: false,
+      width: 130,
+      render: (_: unknown, p: TManagedProxy) => {
+        const inUse = p.hostCount > 0;
+        const del = (
+          <Button size="small" danger disabled={inUse} onClick={() => setDeleteTargets([p])}>
+            {t("proxy_management.delete")}
+          </Button>
+        );
+        return (
+          <Space size={4}>
+            <Button size="small" onClick={() => openEdit(p)}>{t("proxy_management.edit")}</Button>
+            {inUse ? <Tooltip title={t("proxy_management.delete_blocked_hosts", { count: p.hostCount })}>{del}</Tooltip> : del}
+          </Space>
+        );
+      },
+    },
+  ]);
+
+  return (
+    <Flex vertical gap={12}>
+      <Alert type="info" showIcon message={t("proxy_management.desc")} />
+      <DmoveTableFilter
+        filter={filter}
+        placeholder={t("proxy_management.search_placeholder")}
+        button={<Button type="primary" onClick={() => openEdit(undefined)}>{t("proxy_management.create")}</Button>}
+      />
+      {isError ? <Alert type="error" showIcon message={proxyErrorMessage(error, t)} /> : null}
+      <DmoveTable
+        loading={isLoading}
+        columns={columns}
+        dataSource={rows}
+        rowKey="proxyid"
+        showPagination={false}
+        tableId="zabbix-proxies"
+        hasCheckboxAction
+        handleDelete={handleBatchDelete}
+        getCheckboxProps={(p) => ({ disabled: p.hostCount > 0 })}
+      />
+
+      <ProxyFormDrawer open={drawerOpen} proxy={editTarget} onClose={() => setDrawerOpen(false)} />
+
+      <Modal
+        title={t("proxy_management.delete_title")}
+        open={deleteTargets.length > 0}
+        onCancel={() => setDeleteTargets([])}
+        onOk={confirmDelete}
+        okText={t("proxy_management.delete")}
+        okButtonProps={{ danger: true, loading: deleting }}
+        cancelText={t("proxy_management.cancel")}
+        destroyOnHidden
+      >
+        <Flex vertical gap={12}>
+          <Text>{t("proxy_management.delete_warning", { count: deleteTargets.length })}</Text>
+          <List size="small" bordered dataSource={deleteTargets} renderItem={(p) => <List.Item>{p.name}</List.Item>} />
+        </Flex>
+      </Modal>
+    </Flex>
+  );
+};
+
+export default ProxyTab;
