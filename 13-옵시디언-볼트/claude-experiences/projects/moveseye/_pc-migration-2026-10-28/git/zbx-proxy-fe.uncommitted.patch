@@ -0,0 +1,44 @@
+import { QueryParamKeys } from "@/enums/common";
+import { useQueryParams } from "@/hooks/useQueryParams";
+import { Flex, Tabs } from "antd";
+import { useTranslation } from "react-i18next";
+import ProxyGroupTab from "./ProxyGroupTab";
+import ProxyTab from "./ProxyTab";
+
+export const PROXY_TABS = { PROXIES: "proxies", GROUPS: "groups" } as const;
+
+// Zabbix 관리 > 프록시 — 프록시 / 프록시 그룹 두 탭(Zabbix Administration › Proxies·Proxy groups). 계약 contract_proxy.md.
+// 탭·필터는 URL 쿼리(navigate마다 리마운트 — fe-page-remount-on-navigate). 페이지 제목은 브레드크럼이 그린다.
+// 감시 호스트 배정은 이 화면에서 바꾸지 않는다(보기만 — 배정은 호스트 관리).
+const ProxyManagementPage = () => {
+  const { t } = useTranslation();
+  const { params, updateParams } = useQueryParams();
+  const activeKey = params[QueryParamKeys.TAB] === PROXY_TABS.GROUPS ? PROXY_TABS.GROUPS : PROXY_TABS.PROXIES;
+
+  const handleTabChange = (key: string) => {
+    updateParams([
+      { key: QueryParamKeys.TAB, value: key === PROXY_TABS.PROXIES ? null : key },
+      // 탭 전환 시 목록 필터 리셋(알림 관리와 같은 원칙).
+      { key: QueryParamKeys.KEYWORD, value: null },
+      { key: QueryParamKeys.STATUS, value: null },
+      { key: QueryParamKeys.PROXY_MODE, value: null },
+      { key: QueryParamKeys.PROXY_GROUP_ID, value: null },
+    ]);
+  };
+
+  return (
+    <Flex vertical gap={16} className="p-4">
+      <Tabs
+        activeKey={activeKey}
+        onChange={handleTabChange}
+        destroyInactiveTabPane
+        items={[
+          { key: PROXY_TABS.PROXIES, label: t("proxy_management.tab_proxies"), children: <ProxyTab /> },
+          { key: PROXY_TABS.GROUPS, label: t("proxy_management.tab_groups"), children: <ProxyGroupTab /> },
+        ]}
+      />
+    </Flex>
+  );
+};
+
+export default ProxyManagementPage;
diff --git a/src/pages/zabbix-management/proxy/ProxyTab.tsx b/src/pages/zabbix-management/proxy/ProxyTab.tsx
