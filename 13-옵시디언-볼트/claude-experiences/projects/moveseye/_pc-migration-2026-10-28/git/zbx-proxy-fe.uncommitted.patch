+++ b/src/pages/zabbix-management/proxy/proxyErrors.ts
@@ -0,0 +1,43 @@
+import { HTTP_STATUS } from "@/constants/http";
+import type { TFunction } from "i18next";
+
+/** BE 업무 오류 코드 — envelope.errorCode로 오고 message에는 상세(사용 중인 호스트·규칙 이름)만 남는다(ApiError.getClientMessage). */
+const KNOWN_CODES = [
+  "PROXY_NOT_FOUND",
+  "PROXY_NAME_REQUIRED",
+  "PROXY_MODE_INVALID",
+  "PROXY_TLS_REQUIRED",
+  "PROXY_PSK_REQUIRED",
+  "PROXY_LOCAL_ADDRESS_REQUIRED",
+  "PROXY_CREATE_FAILED",
+  "PROXY_IDS_REQUIRED",
+  "PROXY_IN_USE",
+  "PROXY_GROUP_NOT_FOUND",
+  "PROXY_GROUP_NAME_REQUIRED",
+  "PROXY_GROUP_CREATE_FAILED",
+  "PROXY_GROUP_IDS_REQUIRED",
+  "PROXY_GROUP_IN_USE",
+] as const;
+
+/** envelope 오류의 공통 모양 — 변경은 ZabbixManageApiError, 조회(useDmoveQuery)는 ApiEnvelopeError가 같은 필드를 갖는다. */
+type TEnvelopeErrorLike = { code?: number; errorCode?: string; message?: string };
+
+const asEnvelopeError = (error: unknown): TEnvelopeErrorLike | undefined =>
+  error instanceof Error && ("code" in error || "errorCode" in error) ? (error as TEnvelopeErrorLike) : undefined;
+
+/** 오류 → 안내 문구. 아는 코드는 번역(상세를 {{detail}}로), 모르는 코드·Zabbix 원문은 message 그대로. */
+export const proxyErrorMessage = (error: unknown, t: TFunction): string => {
+  const env = asEnvelopeError(error);
+  if (env) {
+    if (env.code === HTTP_STATUS.FORBIDDEN) {
+      return t("proxy_management.permission_denied");
+    }
+    const code = KNOWN_CODES.find((c) => c === env.errorCode);
+    if (code) {
+      const detail = env.message && env.message !== code ? env.message : "";
+      return t(`proxy_management.errors.${code}`, { detail });
+    }
+  }
+  const raw = error instanceof Error ? error.message : "";
+  return raw || t("proxy_management.action_failed");
+};
