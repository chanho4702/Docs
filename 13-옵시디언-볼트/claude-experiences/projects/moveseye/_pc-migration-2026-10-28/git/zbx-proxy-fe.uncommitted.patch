+++ b/src/__tests__/ProxyManagement.test.tsx
@@ -0,0 +1,318 @@
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { MemoryRouter } from "react-router-dom";
+import ProxyFormDrawer, {
+  carryTlsAcrossModes,
+  detailToValues,
+  valuesToRequest,
+} from "@/pages/zabbix-management/proxy/ProxyFormDrawer";
+import ProxyGroupTab from "@/pages/zabbix-management/proxy/ProxyGroupTab";
+import ProxyTab, { tlsLabels } from "@/pages/zabbix-management/proxy/ProxyTab";
+import { proxyErrorMessage } from "@/pages/zabbix-management/proxy/proxyErrors";
+import { ZabbixManageApiError } from "@/services/zabbix-proxy.api";
+import { TManagedProxy, TManagedProxyDetail, TManagedProxyGroup } from "@/types/zabbix-proxy";
+
+jest.mock("@/services/axiosInstance", () => ({
+  __esModule: true,
+  default: { get: jest.fn(), post: jest.fn(), put: jest.fn(), delete: jest.fn() },
+}));
+jest.mock("react-i18next", () => ({
+  useTranslation: () => ({ t: (key: string) => key }),
+  initReactI18next: { type: "3rdParty", init: jest.fn() },
+}));
+const listMock = jest.fn();
+const groupListMock = jest.fn();
+const detailMock = jest.fn();
+const optionsMock = jest.fn();
+const createMutate = jest.fn();
+const updateMutate = jest.fn();
+const deleteMutate = jest.fn();
+jest.mock("@/hooks/useZabbixProxy", () => ({
+  __esModule: true,
+  useProxyList: () => listMock(),
+  useProxyGroupList: () => groupListMock(),
+  useProxyDetail: (id?: string) => detailMock(id),
+  useProxyOptions: () => optionsMock(),
+  useProxyGroupDetail: () => ({ data: undefined, isLoading: false }),
+  useCreateProxy: () => ({ mutate: createMutate, isPending: false }),
+  useUpdateProxy: () => ({ mutate: updateMutate, isPending: false }),
+  useDeleteProxies: () => ({ mutate: deleteMutate, isPending: false }),
+  useCreateProxyGroup: () => ({ mutate: jest.fn(), isPending: false }),
+  useUpdateProxyGroup: () => ({ mutate: jest.fn(), isPending: false }),
+  useDeleteProxyGroups: () => ({ mutate: jest.fn(), isPending: false }),
+}));
+jest.mock("antd", () => {
+  const actual = jest.requireActual("antd");
+  return { ...actual, message: { success: jest.fn(), error: jest.fn() } };
+});
+
+const GLOBAL = {
+  zabbix_agent: "3s", simple_check: "3s", snmp_agent: "3s", external_check: "3s", db_monitor: "3s",
+  http_agent: "10s", ssh_agent: "3s", telnet_agent: "3s", script: "3s", browser: "60s",
+};
+
+const row = (over: Partial<TManagedProxy>): TManagedProxy => ({
+  proxyid: "1", name: "proxy-a", operatingMode: 0, proxyGroup: null, address: "127.0.0.1", port: "10051",
+  allowedAddresses: "10.0.0.5", localAddress: "", localPort: "10051", description: "", state: "ONLINE",
+  lastAccess: 1761530000, version: "7.0.13", compatibility: "CURRENT", hostCount: 0, assignedHostCount: 0,
+  tlsConnect: 1, tlsAccept: 1, pskConfigured: false, customTimeouts: false, ...over,
+});
+
+const detailOf = (summary: TManagedProxy, over: Partial<TManagedProxyDetail> = {}): TManagedProxyDetail => ({
+  summary, tlsIssuer: "", tlsSubject: "", timeouts: {}, hosts: [], assignedHosts: [], hostsTruncated: false,
+  discoveryRules: [], ...over,
+});
+
+const group = (over: Partial<TManagedProxyGroup>): TManagedProxyGroup => ({
+  proxyGroupId: "1", name: "Seoul", failoverDelay: "1m", minOnline: "1", description: "", state: "ONLINE",
+  proxyCount: 0, onlineProxyCount: 0, hostCount: 0, proxies: [], ...over,
+});
+
+describe("proxyErrorMessage", () => {
+  const t = ((k: string, o?: { detail?: string }) => (o?.detail ? `${k}|${o.detail}` : k)) as never;
+
+  it("maps errorCode with detail; 403 is permission; unknown shows Zabbix text", () => {
+    expect(proxyErrorMessage(new ZabbixManageApiError({ code: 400, status: "error", errorCode: "PROXY_IN_USE", message: "p ← 호스트 2개(a, b)" }), t))
+      .toBe("proxy_management.errors.PROXY_IN_USE|p ← 호스트 2개(a, b)");
+    expect(proxyErrorMessage(new ZabbixManageApiError({ code: 400, status: "error", errorCode: "PROXY_TLS_REQUIRED", message: "PROXY_TLS_REQUIRED" }), t))
+      .toBe("proxy_management.errors.PROXY_TLS_REQUIRED");
+    expect(proxyErrorMessage(new ZabbixManageApiError({ code: 403, status: "error", message: "Forbidden" }), t))
+      .toBe("proxy_management.permission_denied");
+    expect(proxyErrorMessage(new ZabbixManageApiError({ code: 400, status: "error", message: "Proxy \"a\" already exists." }), t))
+      .toBe("Proxy \"a\" already exists.");
+  });
+});
+
+describe("form mapping", () => {
+  it("never prefills PSK and turns accept bits into a list", () => {
+    const v = detailToValues(detailOf(row({ tlsAccept: 3, pskConfigured: true })));
+    expect(v.tls_accept).toEqual([1, 2]);
+    expect(v.tls_psk_identity).toBe("");
+    expect(v.tls_psk).toBe("");
+  });
+
+  it("active request sends only the active side; PSK only when typed; no group → no local fields", () => {
+    const v = detailToValues(detailOf(row({ tlsAccept: 2, pskConfigured: true })));
+    const body = valuesToRequest({ ...v, address: "10.0.0.9", local_address: "10.0.0.1" });
+    expect(body).toMatchObject({ operating_mode: 0, tls_accept: 2, allowed_addresses: "10.0.0.5", proxy_groupid: "0", custom_timeouts: 0 });
+    expect(body).not.toHaveProperty("tls_connect");
+    expect(body).not.toHaveProperty("address");
+    expect(body).not.toHaveProperty("local_address");
+    expect(body).not.toHaveProperty("tls_psk");
+    expect(body).not.toHaveProperty("timeouts");
+
+    const typed = valuesToRequest({ ...v, tls_psk_identity: "id", tls_psk: " abcd " });
+    expect(typed).toMatchObject({ tls_psk_identity: "id", tls_psk: "abcd" });
+  });
+
+  it("passive request sends the passive side; group sends local address; custom timeouts sends the ten values", () => {
+    const v = detailToValues(detailOf(row({ operatingMode: 1, tlsConnect: 4, address: "10.0.0.9", proxyGroup: { id: "1", name: "Seoul" }, localAddress: "10.0.0.1", customTimeouts: true }),
+      { timeouts: GLOBAL }));
+    const body = valuesToRequest(v);
+    expect(body).toMatchObject({ operating_mode: 1, tls_connect: 4, address: "10.0.0.9", port: "10051", proxy_groupid: "1", local_address: "10.0.0.1", custom_timeouts: 1 });
+    expect(body).not.toHaveProperty("tls_accept");
+    expect(body).not.toHaveProperty("allowed_addresses");
+    expect(Object.keys(body.timeouts ?? {})).toHaveLength(10);
+  });
+
+  it("carries encryption across a mode switch instead of dropping to none", () => {
+    expect(carryTlsAcrossModes(0, 2, [1])).toEqual({ tls_accept: [2] });
+    expect(carryTlsAcrossModes(1, 1, [1, 4])).toEqual({ tls_connect: 4 });
+    expect(carryTlsAcrossModes(1, 1, [1, 2, 4])).toEqual({ tls_connect: 2 });
+    expect(carryTlsAcrossModes(1, 1, [1])).toEqual({ tls_connect: 1 });
+  });
+
+  it("tlsLabels shows accepted bits for active and the single method for passive", () => {
+    expect(tlsLabels({ operatingMode: 0, tlsConnect: 1, tlsAccept: 6 })).toEqual(["psk", "cert"]);
+    expect(tlsLabels({ operatingMode: 1, tlsConnect: 2, tlsAccept: 1 })).toEqual(["psk"]);
+  });
+});
+
+describe("ProxyTab", () => {
+  beforeEach(() => {
+    jest.clearAllMocks();
+    groupListMock.mockReturnValue({ data: [group({})], isLoading: false });
+    detailMock.mockReturnValue({ data: undefined, isLoading: false });
+    optionsMock.mockReturnValue({ data: { proxyGroups: [{ id: "1", name: "Seoul" }], globalTimeouts: GLOBAL } });
+  });
+
+  it("filters on the screen by mode, state, group and keyword from the URL", () => {
+    listMock.mockReturnValue({ data: [
+      row({}),
+      row({ proxyid: "2", name: "proxy-b", operatingMode: 1, state: "OFFLINE" }),
+      row({ proxyid: "3", name: "proxy-c", operatingMode: 1, state: "OFFLINE", proxyGroup: { id: "1", name: "Seoul" }, address: "10.9.9.9" }),
+    ], isLoading: false });
+    render(
+      <MemoryRouter initialEntries={["/zabbix-management/proxy-management?proxyMode=1&status=OFFLINE&proxyGroupId=1&keyword=10.9"]}>
+        <ProxyTab />
+      </MemoryRouter>
+    );
+    expect(screen.queryByText("proxy-a")).toBeNull();
+    expect(screen.queryByText("proxy-b")).toBeNull();
+    expect(screen.getByText("proxy-c")).toBeTruthy();
+  });
+
+  it("blocks delete on proxies that still monitor hosts and shows outdated version badge", () => {
+    listMock.mockReturnValue({ data: [
+      row({}),
+      row({ proxyid: "2", name: "proxy-b", hostCount: 3, compatibility: "OUTDATED", version: "6.4.0" }),
+    ], isLoading: false });
+    render(<MemoryRouter><ProxyTab /></MemoryRouter>);
+    const deletes = screen.getAllByText("proxy_management.delete").map((el) => el.closest("button") as HTMLButtonElement);
+    expect(deletes.map((b) => b.disabled)).toEqual([false, true]);
+    expect(screen.getByText("proxy_management.compatibility.OUTDATED")).toBeTruthy();
+  });
+
+  it("delete confirms then calls the API with the id", () => {
+    listMock.mockReturnValue({ data: [row({})], isLoading: false });
+    render(<MemoryRouter><ProxyTab /></MemoryRouter>);
+    fireEvent.click(screen.getByText("proxy_management.delete"));
+    const buttons = screen.getAllByText("proxy_management.delete").map((el) => el.closest("button") as HTMLButtonElement);
+    fireEvent.click(buttons[buttons.length - 1]);
+    expect(deleteMutate.mock.calls[0][0]).toEqual(["1"]);
+  });
+
+  it("shows the list error instead of an empty table", () => {
+    listMock.mockReturnValue({ data: undefined, isLoading: false, isError: true, error: Object.assign(new Error("Zabbix unreachable"), { code: 500 }) });
+    render(<MemoryRouter><ProxyTab /></MemoryRouter>);
+    expect(screen.getByText("Zabbix unreachable")).toBeTruthy();
+  });
+});
+
+describe("ProxyGroupTab", () => {
+  beforeEach(() => jest.clearAllMocks());
+
+  it("blocks delete when the group has proxies or hosts and shows online/total", () => {
+    groupListMock.mockReturnValue({ data: [
+      group({}),
+      group({ proxyGroupId: "2", name: "Busan", proxyCount: 2, onlineProxyCount: 1,
+        proxies: [{ proxyid: "1", name: "p-a", state: "ONLINE" }, { proxyid: "2", name: "p-b", state: "OFFLINE" }] }),
+      group({ proxyGroupId: "3", name: "Daegu", hostCount: 4 }),
+    ], isLoading: false });
+    render(<MemoryRouter><ProxyGroupTab /></MemoryRouter>);
+    const deletes = screen.getAllByText("proxy_management.delete").map((el) => el.closest("button") as HTMLButtonElement);
+    expect(deletes.map((b) => b.disabled)).toEqual([false, true, true]);
+    expect(screen.getByText("p-b")).toBeTruthy();
+  });
+});
+
+describe("ProxyFormDrawer", () => {
+  beforeEach(() => {
+    jest.clearAllMocks();
+    optionsMock.mockReturnValue({ data: { proxyGroups: [{ id: "1", name: "Seoul" }], globalTimeouts: GLOBAL } });
+  });
+
+  it("does not prefill or save when the loaded detail belongs to another proxy", () => {
+    detailMock.mockReturnValue({ data: detailOf(row({})), isLoading: false });
+    render(<MemoryRouter><ProxyFormDrawer open proxy={row({ proxyid: "99", name: "other" })} onClose={jest.fn()} /></MemoryRouter>);
+    expect(screen.queryByDisplayValue("proxy-a")).toBeNull();
+    expect((screen.getByText("proxy_management.save").closest("button") as HTMLButtonElement).disabled).toBe(true);
+  });
+
+  it("a detail refetch does not overwrite what the user is editing", () => {
+    detailMock.mockReturnValue({ data: detailOf(row({})), isLoading: false });
+    const { rerender } = render(<MemoryRouter><ProxyFormDrawer open proxy={row({})} onClose={jest.fn()} /></MemoryRouter>);
+    fireEvent.change(document.querySelector("#name") as HTMLInputElement, { target: { value: "편집 중" } });
+    detailMock.mockReturnValue({ data: detailOf(row({ lastAccess: 1761539999 })), isLoading: false });
+    rerender(<MemoryRouter><ProxyFormDrawer open proxy={row({})} onClose={jest.fn()} /></MemoryRouter>);
+    expect((document.querySelector("#name") as HTMLInputElement).value).toBe("편집 중");
+  });
+
+  it("switching a passive PSK proxy to active keeps PSK and saves without re-entering it", async () => {
+    const passive = row({ operatingMode: 1, tlsConnect: 2, address: "10.0.0.9", pskConfigured: true });
+    detailMock.mockReturnValue({ data: detailOf(passive), isLoading: false });
+    render(<MemoryRouter><ProxyFormDrawer open proxy={passive} onClose={jest.fn()} /></MemoryRouter>);
+    fireEvent.click(screen.getByText("proxy_management.mode.0"));
+    expect(screen.getByText("proxy_management.mode_change_warning")).toBeTruthy();
+    fireEvent.click(screen.getByText("proxy_management.save"));
+
+    await waitFor(() => expect(updateMutate).toHaveBeenCalled());
+    const { proxyid, body } = updateMutate.mock.calls[0][0];
+    expect(proxyid).toBe("1");
+    expect(body).toMatchObject({ operating_mode: 0, tls_accept: 2 });
+    expect(body).not.toHaveProperty("tls_psk");
+    expect(body).not.toHaveProperty("tls_psk_identity");
+  });
+
+  it("turning PSK on for a proxy without PSK requires identity and key", async () => {
+    detailMock.mockReturnValue({ data: detailOf(row({})), isLoading: false });
+    render(<MemoryRouter><ProxyFormDrawer open proxy={row({})} onClose={jest.fn()} /></MemoryRouter>);
+    fireEvent.click(screen.getByText("proxy_management.tab_tls"));
+    fireEvent.click(screen.getByText("proxy_management.tls.psk"));
+    expect(screen.getByText("proxy_management.psk_required_hint")).toBeTruthy();
+    fireEvent.click(screen.getByText("proxy_management.save"));
+    expect(await screen.findByText("proxy_management.psk_identity_required")).toBeTruthy();
+    expect(updateMutate).not.toHaveBeenCalled();
+  });
+
+  it("waits for this open's fresh detail instead of filling from an old cache, then saves the fresh state", async () => {
+    const old = row({ tlsAccept: 1 });
+    const fresh = row({ tlsAccept: 2, pskConfigured: true });
+    detailMock.mockReturnValue({ data: detailOf(old), isFetching: true, isLoading: false });
+    const { rerender } = render(<MemoryRouter><ProxyFormDrawer open proxy={row({})} onClose={jest.fn()} /></MemoryRouter>);
+    expect((screen.getByText("proxy_management.save").closest("button") as HTMLButtonElement).disabled).toBe(true);
+    detailMock.mockReturnValue({ data: detailOf(fresh), isFetching: false, isLoading: false });
+    rerender(<MemoryRouter><ProxyFormDrawer open proxy={row({})} onClose={jest.fn()} /></MemoryRouter>);
+    fireEvent.click(screen.getByText("proxy_management.save"));
+
+    await waitFor(() => expect(updateMutate).toHaveBeenCalled());
+    expect(updateMutate.mock.calls[0][0].body).toMatchObject({ tls_accept: 2 });
+  });
+
+  it("a new create starts empty — nothing from the previous create or edit (no leftover PSK)", async () => {
+    detailMock.mockReturnValue({ data: undefined, isLoading: false });
+    const { rerender } = render(<MemoryRouter><ProxyFormDrawer open onClose={jest.fn()} /></MemoryRouter>);
+    fireEvent.change(document.querySelector("#name") as HTMLInputElement, { target: { value: "first" } });
+    fireEvent.change(document.querySelector("#description") as HTMLTextAreaElement, { target: { value: "old note" } });
+    fireEvent.click(screen.getByText("proxy_management.tab_tls"));
+    fireEvent.click(screen.getByText("proxy_management.tls.psk"));
+    fireEvent.change(document.querySelector("#tls_psk_identity") as HTMLInputElement, { target: { value: "old-id" } });
+    rerender(<MemoryRouter><ProxyFormDrawer open={false} onClose={jest.fn()} /></MemoryRouter>);
+    rerender(<MemoryRouter><ProxyFormDrawer open onClose={jest.fn()} /></MemoryRouter>);
+    fireEvent.change(document.querySelector("#name") as HTMLInputElement, { target: { value: "second" } });
+    fireEvent.click(screen.getByText("proxy_management.save"));
+
+    await waitFor(() => expect(createMutate).toHaveBeenCalled());
+    const body = createMutate.mock.calls[0][0];
+    expect(body).toMatchObject({ name: "second", description: "", tls_accept: 1 });
+    expect(body).not.toHaveProperty("tls_psk_identity");
+  });
+
+  it("clearing the port on edit sends the empty value instead of silently keeping the old one", async () => {
+    const passive = row({ operatingMode: 1, address: "10.0.0.9", port: "10051" });
+    detailMock.mockReturnValue({ data: detailOf(passive), isLoading: false });
+    render(<MemoryRouter><ProxyFormDrawer open proxy={passive} onClose={jest.fn()} /></MemoryRouter>);
+    fireEvent.change(document.querySelector("#port") as HTMLInputElement, { target: { value: "" } });
+    fireEvent.click(screen.getByText("proxy_management.save"));
+
+    await waitFor(() => expect(updateMutate).toHaveBeenCalled());
+    expect(updateMutate.mock.calls[0][0].body).toMatchObject({ port: "" });
+  });
+
+  it("a mode round trip restores the original multi-select instead of the collapsed value", async () => {
+    const active = row({ tlsAccept: 7, pskConfigured: true });
+    detailMock.mockReturnValue({ data: detailOf(active), isLoading: false });
+    render(<MemoryRouter><ProxyFormDrawer open proxy={active} onClose={jest.fn()} /></MemoryRouter>);
+    fireEvent.click(screen.getByText("proxy_management.mode.1"));
+    fireEvent.change(document.querySelector("#address") as HTMLInputElement, { target: { value: "10.0.0.9" } });
+    fireEvent.click(screen.getByText("proxy_management.mode.0"));
+    fireEvent.click(screen.getByText("proxy_management.save"));
+
+    await waitFor(() => expect(updateMutate).toHaveBeenCalled());
+    expect(updateMutate.mock.calls[0][0].body).toMatchObject({ operating_mode: 0, tls_accept: 7 });
+  });
+
+  it("turning custom timeouts on fills the empty fields with the global values", async () => {
+    detailMock.mockReturnValue({ data: undefined, isLoading: false });
+    render(<MemoryRouter><ProxyFormDrawer open onClose={jest.fn()} /></MemoryRouter>);
+    fireEvent.change(document.querySelector("#name") as HTMLInputElement, { target: { value: "proxy-new" } });
+    fireEvent.click(screen.getByText("proxy_management.tab_timeouts"));
+    fireEvent.click(screen.getByRole("switch"));
+    expect((document.querySelector("#timeouts_http_agent") as HTMLInputElement).value).toBe("10s");
+    fireEvent.click(screen.getByText("proxy_management.save"));
+
+    await waitFor(() => expect(createMutate).toHaveBeenCalled());
+    const body = createMutate.mock.calls[0][0];
+    expect(body).toMatchObject({ name: "proxy-new", operating_mode: 0, custom_timeouts: 1, proxy_groupid: "0" });
+    expect(body.timeouts).toEqual(GLOBAL);
+  });
+});
